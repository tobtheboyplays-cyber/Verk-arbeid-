# The complete failure evidence for a GameTest log, written whole.
#
# Two defects lived here until 2026-08-26 and both made the judge
# under-report, which is the one direction a judge must never err in:
#
#   1. The roster was piped through `head -5`. A run with fourteen failures
#      stored five of them, so the artifact silently disagreed with the
#      server that produced it -- and the artifact is what survives the run.
#   2. The recorded count came from `grep -c "failed at"`, which counts
#      ERROR lines, not tests. One run reported `failures=5` in its manifest
#      while GameTestServer's own summary said 20. Reproduced directly:
#      run 20260826T020820Z stored five lines and 20 tests had failed.
#
# The count now comes from GameTestServer's own "N required tests failed"
# line -- the authority on how many tests failed -- and both the roster and
# the detail lines are written in full, however long they are.
gametest_evidence() { # $1 = log, $2 = failures file
    local roster detail
    roster=$(sed -n '/required tests failed/,/^.*=====================/p' "$1" \
        | sed 's/.*GameTestServer\]: *//' | grep -c '^- ')
    # `grep -c` exits 1 on zero matches while still PRINTING "0", so a
    # `|| echo 0` fallback appends a second zero, the variable becomes
    # "0\n0", and the numeric comparison below dies with "integer expression
    # expected" -- silently skipping the note in the one case the note exists
    # for. Found by reading, not observed in a run: every run so far has had
    # a message for every failure (roster 15, detail 15), so the zero-detail
    # branch has never yet been reached. `|| true` keeps grep's own "0" and
    # nothing else.
    detail=$(grep -c "failed at" "$1" 2>/dev/null || true)
    detail=${detail:-0}
    {
        echo "=== roster (GameTestServer's own summary -- AUTHORITATIVE) ==="
        sed -n '/required tests failed/,/^.*=====================/p' "$1" \
            | sed 's/.*GameTestServer\]: *//'
        echo
        echo "=== detail (every failure line, untruncated) ==="
        if [ "$detail" -lt "$roster" ]; then
            # Not every failure prints a "failed at" line: a test that runs out
            # of ticks without tripping an assertion fails with no message of
            # its own. Run 20260826T020820Z had 20 failed tests and 5 such
            # lines. The roster above is the count; this section is detail for
            # the subset that had something to say, and saying so here is the
            # whole reason the old `grep -c` count was wrong for so long.
            echo "NOTE: $roster tests failed but only $detail printed a message."
            echo "      The roster above is the truth; the rest timed out silently."
            echo
        fi
        grep "failed at" "$1"
    } > "$2"
}

# How many TESTS failed, per the server itself. Falls back to counting
# "failed at" lines only if that summary line is absent (a crash before the
# summary was printed), and says so rather than reporting a smaller number
# as though it were the truth.
gametest_failcount() { # $1 = log
    local n
    # Anchor on the emitter, not on a token count. The first version of this
    # counted three whitespace-separated tokens before the number -- and
    # GameTestServer's own prefix is "[time] [Server thread/INFO]
    # [minecraft/GameTestServer]:", which has a space INSIDE the second
    # bracket, so the anchored pattern never matched a single real log and
    # the unanchored fallback below did all the work silently. Caught by an
    # adversarial review, not by a failure: a fallback that always fires
    # looks exactly like a primary that always works.
    n=$(grep -oP 'GameTestServer\]: \K[0-9]+(?= required tests failed)' "$1" 2>/dev/null | tail -1)
    if [ -z "$n" ]; then
        n=$(grep -oP '[0-9]+(?= required tests failed)' "$1" 2>/dev/null | tail -1)
    fi
    if [ -n "$n" ]; then echo "$n"; else
        echo "$(grep -c "failed at" "$1" 2>/dev/null || echo 0)+ (no server summary; error lines, not tests)"
    fi
}

suite_gametest() {
