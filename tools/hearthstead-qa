#!/bin/bash -p
# Hearthstead QA controller — the only approved entry point for testing.
# See qa/PROTOCOL.md (PROTOCOL_VERSION 1.2.0).
set -u
set -o pipefail

# The controller is a trust boundary: it owns shared ports, recovery records,
# installation caches and the completion manifest.  Before using PATH or
# launching another interpreter, discard every ambient shell/Python startup
# hook and imported function.  The lock-owned child is later rebuilt with
# `env -i`; this first scrub also keeps the outer dispatcher deterministic.
HSQA_SYSTEM_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PATH="$HSQA_SYSTEM_PATH"
LANG=C.UTF-8
LC_ALL=C
TMPDIR=/tmp
export PATH LANG LC_ALL TMPDIR
while IFS= read -r HSQA_IMPORTED_FUNCTION; do
    [ -n "$HSQA_IMPORTED_FUNCTION" ] \
        && builtin unset -f -- "$HSQA_IMPORTED_FUNCTION" 2>/dev/null || true
done < <(builtin compgen -A function)
builtin export -n BASHOPTS SHELLOPTS 2>/dev/null || true

# Capture the only authenticated disposable-fixture inputs before removing
# all ambient authority/root overrides.  They are validated against the
# controller copy's canonical /tmp prefix below; arbitrary production callers
# can never redirect PID, install, artifact or tmux state.
REQUESTED_REAP_FIXTURE_ROOT="${HSQA_REAP_FIXTURE_ROOT:-}"
REQUESTED_REAP_FIXTURE_TOKEN="${HSQA_REAP_FIXTURE_TOKEN:-}"
REQUESTED_PERF_FIXTURE_MODE="${HSQA_PERF_FIXTURE_MODE:-}"
REQUESTED_PERF_FIXTURE_ROOT="${HSQA_PERF_FIXTURE_ROOT:-}"
REQUESTED_PERF_FIXTURE_TOKEN="${HSQA_PERF_FIXTURE_TOKEN:-}"
REQUESTED_FULL_MARK_TEST_PAUSE="${HSQA_FULL_MARK_TEST_PAUSE:-}"
REQUESTED_SUITE_LOCK_TOKEN="${HSQA_SUITE_LOCK_TOKEN:-}"
REQUESTED_LOCK_BOOTSTRAPPED="${HSQA_LOCK_BOOTSTRAPPED:-}"
REQUESTED_FULL_MARKED="${HSQA_FULL_MARKED:-}"
REQUESTED_ENV_CLEANED="${HSQA_ENV_CLEANED:-}"
builtin unset BASH_ENV ENV CDPATH GLOBIGNORE PYTHONPATH PYTHONHOME \
    PYTHONSTARTUP PYTHONINSPECT PYTHONWARNINGS PYTHONUSERBASE \
    _JAVA_OPTIONS JAVA_TOOL_OPTIONS GRADLE_OPTS TMUX TMUX_PANE \
    HSQA_ACTIVE HSQA_ARTIFACTS HSQA_CLIENT_INSTALL_DIR HSQA_GRADLE_CACHE \
    HSQA_INST_ROOT HSQA_INSTALL_DIR HSQA_PIDDIR HSQA_REPO HSQA_REPORTS \
    HSQA_SAFE_TMP_ROOT HSQA_TMUX_SOCKET HSQA_TMUX_SELFTEST_MODE \
    HSQA_LIB_READ_ONLY HSQA_PROCESS_IDENTITY HSQA_GAMETEST_NAMESPACE \
    HSQA_TRACE HSQA_TRACE_FILE HSQA_SUITE_LOCK_TOKEN \
    HSQA_LOCK_BOOTSTRAPPED HSQA_FULL_MARKED HSQA_REAP_FIXTURE_ROOT \
    HSQA_REAP_FIXTURE_TOKEN HSQA_PERF_FIXTURE_MODE \
    HSQA_PERF_FIXTURE_ROOT HSQA_PERF_FIXTURE_TOKEN \
    HSQA_FULL_MARK_TEST_PAUSE HSQA_ENV_CLEANED 2>/dev/null || true

CONTROLLER_PATH=$(/usr/bin/realpath -e -- "${BASH_SOURCE[0]}") \
    || { echo "FATAL: controller path cannot be resolved" >&2; exit 2; }
case "$CONTROLLER_PATH" in
    */tools/hearthstead-qa) ;;
    *) echo "FATAL: controller is not at the canonical repository path" >&2; exit 2;;
esac
REPO="${CONTROLLER_PATH%/tools/hearthstead-qa}"
[ -d "$REPO/qa/scripts" ] && [ -d "$REPO/hearthstead-neoforge" ] \
    || { echo "FATAL: controller repository layout is incomplete" >&2; exit 2; }
MOD="$REPO/hearthstead-neoforge"
QA="$REPO/qa"
REPORTS="$QA/reports"
ARTIFACTS="$REPORTS/artifacts"
PROTOCOL_VERSION="1.2.0"
# Deliberate normal-namespace roster. Active performance tests live in their
# own namespace and must never satisfy gametest/behavior/full. Update this
# number only alongside a reviewed normal GameTest addition/removal.
EXPECTED_REQUIRED_GAMETESTS=600
EXPECTED_FULL_SUITES=(doctor assets animation build gametest behavior dedicated \
    blessing_restart performance client playtest visual)
# Test-only gate barriers are never ambient authority.  Production starts
# with these globals empty; full_attempt_contract_selftest shadows them with
# dynamically-scoped locals inside its isolated /tmp fixture.
GATE_FINAL_FP_SELFTEST_READY=''
GATE_FINAL_FP_SELFTEST_HOLD=''

hsqa_fixture_authority_valid() { # <root> <48-hex-token>
    local root="$1" token="$2" suffix token_file uid lexical canonical
    [[ "$root" =~ ^/tmp/hsqa-reap-fixture\.[A-Za-z0-9]{6,64}$ ]] \
        && [[ "$token" =~ ^[0-9a-f]{48}$ ]] || return 1
    suffix="${root#/tmp/hsqa-reap-fixture.}"
    case "$suffix" in ''|*/*) return 1;; esac
    lexical=$(/usr/bin/realpath -ms -- "$root") || return 1
    canonical=$(/usr/bin/realpath -m -- "$root") || return 1
    [ "$root" = "$lexical" ] && [ "$root" = "$canonical" ] \
        && [ -d "$root" ] && [ ! -L "$root" ] || return 1
    uid=$(/usr/bin/id -u) || return 1
    [ "$(/usr/bin/stat -c %u -- "$root" 2>/dev/null)" = "$uid" ] \
        && [ "$(/usr/bin/stat -c %a -- "$root" 2>/dev/null)" = 700 ] \
        || return 1
    token_file="$root/.hsqa-reap-fixture-token"
    [ -f "$token_file" ] && [ ! -L "$token_file" ] \
        && [ "$(/usr/bin/stat -c %u -- "$token_file" 2>/dev/null)" = "$uid" ] \
        && [ "$(/usr/bin/stat -c %a -- "$token_file" 2>/dev/null)" = 600 ] \
        && [ "$(/usr/bin/stat -c %h -- "$token_file" 2>/dev/null)" = 1 ] \
        && [ "$(/usr/bin/stat -c %s -- "$token_file" 2>/dev/null)" = 48 ] \
        && /usr/bin/cmp -s -- "$token_file" <(builtin printf '%s' "$token")
}

hsqa_repo_fixture_kind() {
    local suffix
    case "$REPO" in
        /tmp/hsqa-full-dispatch.*)
            suffix="${REPO#/tmp/hsqa-full-dispatch.}"
            case "$suffix" in ''|*/*) return 1;; esac
            printf 'full\n';;
        /tmp/hsqa-perf-launch-*)
            suffix="${REPO#/tmp/hsqa-perf-launch-}"
            case "$suffix" in ''|*/*) return 1;; esac
            printf 'perf\n';;
        *) printf 'production\n';;
    esac
}

HSQA_FIXTURE_KIND=$(hsqa_repo_fixture_kind) \
    || { echo "FATAL: malformed disposable controller path" >&2; exit 2; }

# Canonical production authority.  A full-attempt interruption test derives
# all roots from its authenticated copy rather than trusting its exported
# overrides.  A performance crash fixture derives only its recovery root
# after exact token-file authentication.
HSQA_SAFE_TMP_ROOT=/tmp
HSQA_PIDDIR=/tmp/claude-0/hsqa-pids-v2
HSQA_INST_ROOT=/tmp/claude-0/hsqa-inst-v2
HSQA_INSTALL_DIR=/tmp/claude-0/hsqa-install-v2
HSQA_CLIENT_INSTALL_DIR=/tmp/claude-0/hsqa-client-install-v2
HSQA_TMUX_SOCKET=/tmp/claude-0/hearthstead-qa-v2.tmux
case "$HSQA_FIXTURE_KIND" in
    full)
        HSQA_SAFE_TMP_ROOT="$REPO/tmp"
        HSQA_PIDDIR="$REPO/tmp/pids"
        HSQA_INST_ROOT="$REPO/tmp/instances"
        HSQA_INSTALL_DIR="$REPO/tmp/install"
        HSQA_CLIENT_INSTALL_DIR="$REPO/tmp/client-install"
        [ -z "$REQUESTED_REAP_FIXTURE_ROOT$REQUESTED_REAP_FIXTURE_TOKEN\
$REQUESTED_PERF_FIXTURE_MODE$REQUESTED_PERF_FIXTURE_ROOT\
$REQUESTED_PERF_FIXTURE_TOKEN" ] \
            || { echo "FATAL: performance fixture authority on full fixture" >&2; exit 2; }
        if [ -n "$REQUESTED_FULL_MARK_TEST_PAUSE" ]; then
            [ "$REQUESTED_FULL_MARK_TEST_PAUSE" = 1 ] \
                || { echo "FATAL: invalid full-marker fixture seam" >&2; exit 2; }
            HSQA_FULL_MARK_TEST_PAUSE=1
        fi;;
    perf)
        [ -z "$REQUESTED_FULL_MARK_TEST_PAUSE" ] \
            || { echo "FATAL: full-marker seam on performance fixture" >&2; exit 2; }
        case "${1:-help}" in performance|gate|reap) ;;
            *) echo "FATAL: performance fixture command is not authorized" >&2; exit 2;;
        esac
        [ "$REQUESTED_PERF_FIXTURE_MODE" = prelaunch-artifact \
            ] || [ "$REQUESTED_PERF_FIXTURE_MODE" = post-release-crash ] \
            || { echo "FATAL: invalid performance fixture mode" >&2; exit 2; }
        [ "$REQUESTED_PERF_FIXTURE_ROOT" = "$REQUESTED_REAP_FIXTURE_ROOT" ] \
            && [ "$REQUESTED_PERF_FIXTURE_TOKEN" = "$REQUESTED_REAP_FIXTURE_TOKEN" ] \
            && hsqa_fixture_authority_valid "$REQUESTED_REAP_FIXTURE_ROOT" \
                "$REQUESTED_REAP_FIXTURE_TOKEN" \
            || { echo "FATAL: unauthenticated performance/reaper fixture" >&2; exit 2; }
        HSQA_REAP_FIXTURE_ROOT="$REQUESTED_REAP_FIXTURE_ROOT"
        HSQA_REAP_FIXTURE_TOKEN="$REQUESTED_REAP_FIXTURE_TOKEN"
        HSQA_PERF_FIXTURE_MODE="$REQUESTED_PERF_FIXTURE_MODE"
        HSQA_PERF_FIXTURE_ROOT="$REQUESTED_PERF_FIXTURE_ROOT"
        HSQA_PERF_FIXTURE_TOKEN="$REQUESTED_PERF_FIXTURE_TOKEN"
        HSQA_SAFE_TMP_ROOT="$REQUESTED_REAP_FIXTURE_ROOT"
        HSQA_PIDDIR="$REQUESTED_REAP_FIXTURE_ROOT/pids";;
    production)
        [ -z "$REQUESTED_REAP_FIXTURE_ROOT$REQUESTED_REAP_FIXTURE_TOKEN\
$REQUESTED_PERF_FIXTURE_MODE$REQUESTED_PERF_FIXTURE_ROOT\
$REQUESTED_PERF_FIXTURE_TOKEN$REQUESTED_FULL_MARK_TEST_PAUSE" ] \
            || { echo "FATAL: disposable QA seam is forbidden in production" >&2; exit 2; };;
esac
export HSQA_SAFE_TMP_ROOT HSQA_PIDDIR HSQA_INST_ROOT HSQA_INSTALL_DIR \
    HSQA_CLIENT_INSTALL_DIR HSQA_TMUX_SOCKET
[ -z "${HSQA_REAP_FIXTURE_ROOT:-}" ] || export HSQA_REAP_FIXTURE_ROOT HSQA_REAP_FIXTURE_TOKEN
[ -z "${HSQA_PERF_FIXTURE_MODE:-}" ] || export HSQA_PERF_FIXTURE_MODE \
    HSQA_PERF_FIXTURE_ROOT HSQA_PERF_FIXTURE_TOKEN
[ -z "${HSQA_FULL_MARK_TEST_PAUSE:-}" ] || export HSQA_FULL_MARK_TEST_PAUSE
export HSQA_ACTIVE=1   # lets the pre-tool hook distinguish controller runs

mark_full_attempt_in_progress() {
    /usr/bin/python3 -I - "$REPORTS/.stale" "$$" "$(date -u +%Y%m%dT%H%M%S.%NZ)" <<'PYEOF'
import os, stat, sys, tempfile
destination, pid, started = sys.argv[1:]
if os.path.lexists(destination):
    mode = os.lstat(destination).st_mode
    if not stat.S_ISREG(mode) or stat.S_ISLNK(mode):
        raise SystemExit("refusing corrupt/non-regular stale marker")
parent = os.path.dirname(destination)
fd, temporary = tempfile.mkstemp(prefix=".stale.tmp.", dir=parent)
try:
    with os.fdopen(fd, "w") as handle:
        handle.write(f"full-attempt-in-progress pid={pid} started={started}\n")
        handle.flush()
        os.fsync(handle.fileno())
    os.replace(temporary, destination)
    result = os.lstat(destination)
    if not stat.S_ISREG(result.st_mode) or stat.S_ISLNK(result.st_mode):
        raise RuntimeError("stale marker publication was not a regular file")
finally:
    try:
        os.unlink(temporary)
    except FileNotFoundError:
        pass
PYEOF
}

clear_full_attempt_marker() {
    [ -f "$REPORTS/.stale" ] && [ ! -L "$REPORTS/.stale" ] || return 1
    rm -f -- "$REPORTS/.stale" || return 1
    [ ! -e "$REPORTS/.stale" ] && [ ! -L "$REPORTS/.stale" ]
}

ensure_gate_red() {
    if [ ! -e "$REPORTS/.stale" ] && [ ! -L "$REPORTS/.stale" ]; then
        mark_full_attempt_in_progress
        return
    fi
    # Any pre-existing non-regular/symlink marker is deliberately left in
    # place: cmd_gate treats its lexical existence as corrupt and red, while
    # replacing or touching it could follow an attacker-controlled symlink.
    return 0
}

# All state-mutating controller commands are globally single-flight. `flock`
# owns the lock in a tiny parent process and --close keeps the descriptor out
# of Minecraft/Gradle descendants, so a detached child cannot hold the suite
# lock forever. A contender exits 75 before creating a run directory or
# touching run/world/latest.
CONTROLLER_COMMAND="${1:-help}"
CONTROLLER_MUTATES=1
case "$CONTROLLER_COMMAND" in
    gate|release-client-gate|status|help|-h|--help|startup-selftest|controller-contract-selftest) CONTROLLER_MUTATES=0 ;;
esac
if [ "$CONTROLLER_COMMAND" = reap ]; then
    case "${2:-check}" in check|dry-run|dryrun) CONTROLLER_MUTATES=0;; esac
fi
CONTROLLER_LOCK_REQUIRED=1
case "$CONTROLLER_COMMAND" in
    status|help|-h|--help|startup-selftest) CONTROLLER_LOCK_REQUIRED=0 ;;
esac
SUITE_LOCK="/tmp/hearthstead-qa-v2.lock"
LOCK_BOOTSTRAP="$QA/scripts/controller_lock_bootstrap.sh"

HSQA_UID=$(/usr/bin/id -u) \
    || { echo "FATAL: current uid cannot be resolved" >&2; exit 2; }
HSQA_CANONICAL_HOME=$(/usr/bin/getent passwd "$HSQA_UID" 2>/dev/null \
    | /usr/bin/cut -d: -f6)
case "$HSQA_CANONICAL_HOME" in
    /*) [ -d "$HSQA_CANONICAL_HOME" ] || HSQA_CANONICAL_HOME=/tmp;;
    *) HSQA_CANONICAL_HOME=/tmp;;
esac
case "$HSQA_CANONICAL_HOME" in *[$'\r\n']*) HSQA_CANONICAL_HOME=/tmp;; esac
HOME="$HSQA_CANONICAL_HOME"
SHELL=/bin/bash
TERM=xterm-256color
HSQA_GRADLE_CACHE="$HOME/.gradle/caches"
HSQA_LEVEL_TYPE=flat
export HOME SHELL TERM HSQA_GRADLE_CACHE HSQA_LEVEL_TYPE

# Only documented, non-authority runtime tuning crosses the `env -i`
# boundary.  New knobs must be added deliberately; arbitrary HSQA_* values
# (especially test seams and filesystem roots) are dropped.
HSQA_OPTIONAL_FORWARD_NAMES=(
    HSQA_BLESSING_RESTART_DISPLAY HSQA_BLESSING_RESTART_PORT
    HSQA_CLIENT_FRAME_TIMEOUT HSQA_DEDICATED_PORT HSQA_DISPLAY_HEIGHT
    HSQA_DISPLAY_WIDTH HSQA_ENSURE_GRAB_ATTEMPTS HSQA_GUI_SCALE
    HSQA_INPUT_RESPONSE_TIMEOUT HSQA_LANGUAGE HSQA_LIVE_PORT
    HSQA_PERFORMANCE_PORT HSQA_PERFORMANCE_TIMEOUT_SECONDS
    HSQA_PERF_SAMPLE_COUNT HSQA_PERF_SAMPLE_INTERVAL_SECONDS
    HSQA_PERF_START_DELAY_SECONDS HSQA_PERF_WARMUP_SECONDS
    HSQA_PLAYTEST_PORT HSQA_PLAYTEST_SCENARIO HSQA_ROTATION_QUERY_TIMEOUT
)

hsqa_build_lock_environment() { # <token>; populates HSQA_LOCK_ENV
    local token="$1" name value
    HSQA_LOCK_ENV=(
        "PATH=$HSQA_SYSTEM_PATH" "HOME=$HOME" "LANG=C.UTF-8" "LC_ALL=C"
        "SHELL=/bin/bash" "TERM=xterm-256color" "TMPDIR=/tmp"
        "HSQA_ACTIVE=1" "HSQA_REPO=$REPO" "HSQA_REPORTS=$REPORTS"
        "HSQA_ARTIFACTS=$ARTIFACTS" "HSQA_SAFE_TMP_ROOT=$HSQA_SAFE_TMP_ROOT"
        "HSQA_PIDDIR=$HSQA_PIDDIR" "HSQA_INST_ROOT=$HSQA_INST_ROOT"
        "HSQA_INSTALL_DIR=$HSQA_INSTALL_DIR"
        "HSQA_CLIENT_INSTALL_DIR=$HSQA_CLIENT_INSTALL_DIR"
        "HSQA_GRADLE_CACHE=$HSQA_GRADLE_CACHE" "HSQA_LEVEL_TYPE=flat"
        "HSQA_TMUX_SOCKET=$HSQA_TMUX_SOCKET"
        "HSQA_SUITE_LOCK_TOKEN=$token"
    )
    if [ -n "${HSQA_REAP_FIXTURE_ROOT:-}" ]; then
        HSQA_LOCK_ENV+=("HSQA_REAP_FIXTURE_ROOT=$HSQA_REAP_FIXTURE_ROOT"
            "HSQA_REAP_FIXTURE_TOKEN=$HSQA_REAP_FIXTURE_TOKEN"
            "HSQA_PERF_FIXTURE_MODE=$HSQA_PERF_FIXTURE_MODE"
            "HSQA_PERF_FIXTURE_ROOT=$HSQA_PERF_FIXTURE_ROOT"
            "HSQA_PERF_FIXTURE_TOKEN=$HSQA_PERF_FIXTURE_TOKEN")
    fi
    [ -z "${HSQA_FULL_MARK_TEST_PAUSE:-}" ] \
        || HSQA_LOCK_ENV+=("HSQA_FULL_MARK_TEST_PAUSE=1")
    for name in "${HSQA_OPTIONAL_FORWARD_NAMES[@]}"; do
        if [[ -v "$name" ]]; then
            value="${!name}"
            [ "${#value}" -le 256 ] \
                && [[ "$value" =~ ^[[:print:]]*$ ]] \
                && [[ "$value" != *$'\r'* ]] && [[ "$value" != *$'\n'* ]] \
                || { echo "FATAL: unsafe value for $name" >&2; return 2; }
            HSQA_LOCK_ENV+=("$name=$value")
        fi
    done
}

hsqa_build_readonly_environment() {
    HSQA_READONLY_ENV=(
        "PATH=$HSQA_SYSTEM_PATH" "HOME=$HOME" "LANG=C.UTF-8" "LC_ALL=C"
        "SHELL=/bin/bash" "TERM=xterm-256color" "TMPDIR=/tmp"
        "HSQA_ACTIVE=1" "HSQA_SAFE_TMP_ROOT=$HSQA_SAFE_TMP_ROOT"
        "HSQA_PIDDIR=$HSQA_PIDDIR" "HSQA_INST_ROOT=$HSQA_INST_ROOT"
        "HSQA_INSTALL_DIR=$HSQA_INSTALL_DIR"
        "HSQA_CLIENT_INSTALL_DIR=$HSQA_CLIENT_INSTALL_DIR"
        "HSQA_GRADLE_CACHE=$HSQA_GRADLE_CACHE" "HSQA_LEVEL_TYPE=flat"
        "HSQA_TMUX_SOCKET=$HSQA_TMUX_SOCKET" "HSQA_ENV_CLEANED=1"
    )
    if [ -n "${HSQA_REAP_FIXTURE_ROOT:-}" ]; then
        HSQA_READONLY_ENV+=("HSQA_REAP_FIXTURE_ROOT=$HSQA_REAP_FIXTURE_ROOT"
            "HSQA_REAP_FIXTURE_TOKEN=$HSQA_REAP_FIXTURE_TOKEN"
            "HSQA_PERF_FIXTURE_MODE=$HSQA_PERF_FIXTURE_MODE"
            "HSQA_PERF_FIXTURE_ROOT=$HSQA_PERF_FIXTURE_ROOT"
            "HSQA_PERF_FIXTURE_TOKEN=$HSQA_PERF_FIXTURE_TOKEN")
    fi
    [ -z "${HSQA_FULL_MARK_TEST_PAUSE:-}" ] \
        || HSQA_READONLY_ENV+=("HSQA_FULL_MARK_TEST_PAUSE=1")
}

hsqa_readonly_environment_is_exact() {
    /usr/bin/python3 -I - "${HSQA_READONLY_ENV[@]}" <<'PYEOF'
import os, sys

expected = {}
for assignment in sys.argv[1:]:
    name, value = assignment.split("=", 1)
    if name in expected:
        raise SystemExit(2)
    expected[name] = value
actual = dict(os.environ)
# Bash creates/updates only these bookkeeping entries around an exec.  They
# carry no hook, path or harness authority and are deliberately not forwarded.
for name in ("PWD", "SHLVL", "_"):
    actual.pop(name, None)
raise SystemExit(0 if actual == expected else 1)
PYEOF
}

hsqa_prepare_suite_lock() {
    if [ ! -e "$SUITE_LOCK" ] && [ ! -L "$SUITE_LOCK" ]; then
        (umask 077; set -o noclobber; : > "$SUITE_LOCK") 2>/dev/null || true
    fi
    [ -f "$SUITE_LOCK" ] && [ ! -L "$SUITE_LOCK" ] \
        && [ "$(/usr/bin/stat -Lc %u -- "$SUITE_LOCK" 2>/dev/null)" = "$HSQA_UID" ] \
        && [ "$(/usr/bin/stat -Lc %h -- "$SUITE_LOCK" 2>/dev/null)" = 1 ] \
        || return 1
    /usr/bin/chmod 600 -- "$SUITE_LOCK" || return 1
    [ "$(/usr/bin/stat -Lc %a -- "$SUITE_LOCK" 2>/dev/null)" = 600 ]
}

hsqa_lock_parent_proven() {
    local parent="$1" expected_index=0 current arg
    local -a parent_argv expected_argv
    shift
    [ "$(/usr/bin/readlink -f -- "/proc/$parent/exe" 2>/dev/null || true)" \
        = /usr/bin/flock ] || return 1
    current=$(/usr/bin/awk '$1 == "SigIgn:" { print $2 }' \
        "/proc/$parent/status" 2>/dev/null) || return 1
    /usr/bin/python3 -I - "$current" <<'PYEOF' || return 1
import re, sys
value = sys.argv[1]
if not re.fullmatch(r"[0-9A-Fa-f]+", value):
    raise SystemExit(1)
mask = int(value, 16)
raise SystemExit(0 if mask & 2 and mask & (1 << 14) else 1)
PYEOF
    current=0
    for arg in "/proc/$parent/fd/"*; do
        [ "$(/usr/bin/readlink -f -- "$arg" 2>/dev/null || true)" \
            = "$SUITE_LOCK" ] && current=1
    done
    [ "$current" -eq 1 ] || return 1
    current=$(/usr/bin/stat -Lc %i -- "$SUITE_LOCK" 2>/dev/null) || return 1
    [[ "$current" =~ ^[0-9]+$ ]] \
        && /usr/bin/awk -v owner="$parent" -v inode="$current" \
            '$2 == "FLOCK" && $4 == "WRITE" && $5 == owner && $6 ~ (":" inode "$") { found=1 } END { exit !found }' \
            /proc/locks || return 1
    mapfile -d '' -t parent_argv < "/proc/$parent/cmdline" || return 1
    expected_argv=(/usr/bin/flock -n --close --conflict-exit-code 75
        "$SUITE_LOCK" /usr/bin/env -i "${HSQA_LOCK_ENV[@]}"
        /bin/bash --noprofile --norc -p "$LOCK_BOOTSTRAP"
        "$CONTROLLER_PATH" "$@")
    [ "${#parent_argv[@]}" -eq "${#expected_argv[@]}" ] || return 1
    for ((expected_index=0; expected_index<${#expected_argv[@]}; expected_index++)); do
        [ "${parent_argv[$expected_index]}" = "${expected_argv[$expected_index]}" ] \
            || return 1
    done
}

if [ "$CONTROLLER_LOCK_REQUIRED" -eq 1 ] \
        && [ "$REQUESTED_LOCK_BOOTSTRAPPED" != 1 ]; then
    [ -x /usr/bin/flock ] && [ -x /usr/bin/env ] && [ -x /bin/bash ] \
        && [ -x /usr/bin/python3 ] \
        || { echo "FATAL: absolute QA lock/bootstrap tools are unavailable" >&2; exit 2; }
    hsqa_prepare_suite_lock \
        || { echo "FATAL: unsafe host-global suite lock" >&2; exit 2; }
    # Host-global on purpose: the Windows checkout and isolated /opt or /tmp
    # clones still share ports and install caches. A repository-local lock on
    # OneDrive/DrvFS cannot serialize those controllers.
    SUITE_LOCK_TOKEN=$(/usr/bin/od -An -N24 -tx1 /dev/urandom 2>/dev/null \
        | /usr/bin/tr -d ' \n')
    [[ "$SUITE_LOCK_TOKEN" =~ ^[0-9a-f]{48}$ ]] \
        || { echo "FATAL: could not create suite-lock authentication token" >&2; exit 2; }
    hsqa_build_lock_environment "$SUITE_LOCK_TOKEN" || exit 2
    # The lock owner inherits ignored terminal signals, while the actual
    # controller child explicitly resets them.  Ctrl-C therefore reaches the
    # child's cleanup trap but cannot release the host-global lock until that
    # cleanup and the child itself have finished.
    trap '' INT TERM
    /usr/bin/flock -n --close --conflict-exit-code 75 "$SUITE_LOCK" \
        /usr/bin/env -i "${HSQA_LOCK_ENV[@]}" \
            /bin/bash --noprofile --norc -p "$LOCK_BOOTSTRAP" \
                "$CONTROLLER_PATH" "$@"
    LOCKED_STATUS=$?
    trap - INT TERM
    if [ "$LOCKED_STATUS" -eq 75 ]; then
        echo "FATAL: another Hearthstead QA suite owns $SUITE_LOCK" >&2
    fi
    exit "$LOCKED_STATUS"
fi
if [ "$CONTROLLER_LOCK_REQUIRED" -eq 1 ]; then
    # Never trust an ambient "already locked" flag. The child must have a
    # high-entropy token in its actual flock-wrapper parent's argv, and a
    # second nonblocking acquisition must prove that parent still owns the
    # host-global lock.
    HSQA_SUITE_LOCK_TOKEN="$REQUESTED_SUITE_LOCK_TOKEN"
    HSQA_LOCK_BOOTSTRAPPED="$REQUESTED_LOCK_BOOTSTRAPPED"
    HSQA_FULL_MARKED="$REQUESTED_FULL_MARKED"
    export HSQA_SUITE_LOCK_TOKEN HSQA_LOCK_BOOTSTRAPPED HSQA_FULL_MARKED
    [[ "$HSQA_SUITE_LOCK_TOKEN" =~ ^[0-9a-f]{48}$ ]] \
        && [ "$HSQA_LOCK_BOOTSTRAPPED" = 1 ] \
        && [[ "$HSQA_FULL_MARKED" =~ ^[01]$ ]] \
        || { echo "FATAL: unauthenticated suite-lock child mode" >&2; exit 2; }
    hsqa_build_lock_environment "$HSQA_SUITE_LOCK_TOKEN" || exit 2
    hsqa_lock_parent_proven "$PPID" "$@" \
        || { echo "FATAL: suite-lock parent identity/argv/inode proof failed" >&2; exit 2; }
    if /usr/bin/flock -n --close "$SUITE_LOCK" /bin/true 2>/dev/null; then
        echo "FATAL: suite-lock parent does not actually hold $SUITE_LOCK" >&2
        exit 2
    fi
else
    # Lock-free status/help cannot inherit spoofed child-mode credentials.
    [ -z "$REQUESTED_SUITE_LOCK_TOKEN$REQUESTED_LOCK_BOOTSTRAPPED\
$REQUESTED_FULL_MARKED" ] \
        || { echo "FATAL: lock credentials on a lock-free command" >&2; exit 2; }
    # `bash -p` suppresses importing an exported shell function into this
    # first interpreter, but its raw BASH_FUNC_* environment entry remains.
    # A later ordinary `bash` (for example the fingerprint helper) would import
    # it unless read-only commands also cross a true env-i boundary.  The
    # marker alone is never trusted: the complete exported environment must
    # match the controller-built whitelist byte-for-byte.
    HSQA_ENV_CLEANED="$REQUESTED_ENV_CLEANED"
    export HSQA_ENV_CLEANED
    hsqa_build_readonly_environment
    if [ "$HSQA_ENV_CLEANED" != 1 ] || ! hsqa_readonly_environment_is_exact; then
        exec /usr/bin/env -i "${HSQA_READONLY_ENV[@]}" \
            /bin/bash --noprofile --norc -p "$CONTROLLER_PATH" "$@"
        exit 2
    fi
fi

# No accepted mutating run touches reports before the host-global lock is
# authenticated.  A full attempt then makes the gate red before any preflight
# or suite can fail, hang, be interrupted, or be SIGKILLed.  Only a fully
# published PASS removes this marker in write_manifest().
if [ "$CONTROLLER_MUTATES" -eq 1 ]; then
    mkdir -p "$REPORTS" "$ARTIFACTS" || exit 2
    if [ "$CONTROLLER_COMMAND" = full ]; then
        [ "${HSQA_LOCK_BOOTSTRAPPED:-0}" = 1 ] \
            && [ "${HSQA_FULL_MARKED:-0}" = 1 ] \
            && [ -f "$REPORTS/.stale" ] \
            && [ ! -L "$REPORTS/.stale" ] \
            || { echo "FATAL: full QA attempt did not enter through its durable lock-owned prelude" >&2; exit 2; }
    fi
fi

qa_eol_preflight() {
    local file failed=0
    while IFS= read -r -d '' file; do
        if LC_ALL=C grep -q $'\r' "$file"; then
            echo "FATAL: executable QA file has CRLF newlines: $file" >&2
            failed=1
        fi
    done < <(find "$QA/hooks" "$QA/scripts" "$MOD/tools" -type f \
        \( -name '*.sh' -o -name '*.py' \) -print0 2>/dev/null)
    for file in "$REPO/tools/hearthstead-qa" "$MOD/gradlew"; do
        [ -f "$file" ] || continue
        if LC_ALL=C grep -q $'\r' "$file"; then
            echo "FATAL: executable QA file has CRLF newlines: $file" >&2
            failed=1
        fi
    done
    return "$failed"
}
qa_eol_preflight || exit 2
# Finding 5: durable evidence (ev_init/check_pass/finish_result/
# write_reproduction) for cmd_provision below.
if [ "$CONTROLLER_MUTATES" -eq 1 ]; then
    . "$QA/scripts/lib_harness.sh"
else
    # gate/status/help must remain read-only even though gate takes the global
    # lock.  In particular they must not claim pid/cache directories or create
    # the compatibility artifacts symlink merely by inspecting state.
    HSQA_LIB_READ_ONLY=1 . "$QA/scripts/lib_harness.sh"
fi

TS="$(date -u +%Y%m%dT%H%M%S.%NZ)"
if [ "$CONTROLLER_MUTATES" -eq 1 ]; then
    RUN_DIR=$(mktemp -d "$ARTIFACTS/${TS}-$$.XXXXXX") \
        || { echo "FATAL: could not reserve a unique controller run directory" >&2; exit 2; }
else
    RUN_DIR="$ARTIFACTS/read-only-unused-${TS}-$$"
fi

fingerprint_from_helper() { # <helper> <repo-root>
    local helper="$1" repo="$2" value
    [ -f "$helper" ] || return 1
    value="$(/bin/bash --noprofile --norc -p "$helper" "$repo")" || return 1
    [[ "$value" =~ ^[0-9a-f]{64}$ ]] || return 1
    printf '%s\n' "$value"
}

fingerprint() {
    # Covers everything that decides either what the mod DOES or what the
    # suites ASSERT. qa/scripts and qa/scenarios are in deliberately: an
    # assertion can be loosened there, and without them a stored green would
    # go on looking current — which is INV-10 with the lock removed, and the
    # same self-satisfying shape the review's findings 1-3 were about, one
    # level up. Proven live: commit 4487f1b changed live.sh's and
    # lib_harness.sh's verdict logic while every stored manifest carried on
    # reporting the same fingerprint.
    #
    # qa/reports is deliberately OUT: every run writes into it, so including
    # it would change the fingerprint on every run and it would never settle.
    # __pycache__ is out for the same reason — running a generator rewrites
    # .pyc files and would invalidate evidence that nothing real had changed.
    #
    # The CONTROLLER ITSELF is in as of 2026-08-26. It was excluded, which
    # was the same hole one level up from the one this comment already
    # warns about: qa/scripts is fingerprinted because an assertion can be
    # loosened there, but the file that decides PASS from FAIL -- that reads
    # the log, counts the failures and writes the verdict -- was not. It had
    # been under-reporting failures for an unknown number of runs (a
    # `head -5` roster and a count of error lines rather than of tests), and
    # no stored fingerprint would have changed when that was fixed. A judge
    # that is not fingerprinted is a judge that can be edited without the
    # evidence noticing. Adding it invalidates every fingerprint stored
    # before this date, which is correct: those runs were judged by a
    # different judge.
    fingerprint_from_helper "$QA/scripts/source_fingerprint.sh" "$REPO"
}

assert_source_unchanged() { # <phase>; sticky once any phase observes drift
    local phase="$1" current
    [ "${SOURCE_DRIFT:-0}" -eq 0 ] || return 1
    if ! current="$(fingerprint)"; then
        SOURCE_DRIFT=1
        SOURCE_DRIFT_NOTE="source fingerprint failed during $phase"
        return 1
    fi
    if [ "$current" != "${START_FINGERPRINT:-}" ]; then
        SOURCE_DRIFT=1
        SOURCE_DRIFT_NOTE="source changed during run at $phase: start=${START_FINGERPRINT:-missing} current=$current"
        return 1
    fi
}

fingerprint_contract_selftest() {
    local empty_helper failed_helper invalid_helper
    empty_helper=$(mktemp) || return 1
    failed_helper=$(mktemp) || { rm -f "$empty_helper"; return 1; }
    invalid_helper=$(mktemp) \
        || { rm -f "$empty_helper" "$failed_helper"; return 1; }
    printf '#!/usr/bin/env bash\nexit 0\n' > "$empty_helper"
    printf '#!/usr/bin/env bash\nexit 7\n' > "$failed_helper"
    printf '#!/usr/bin/env bash\nprintf "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\\n"\n' \
        > "$invalid_helper"
    if fingerprint_from_helper "$QA/scripts/does-not-exist" "$REPO" >/dev/null 2>&1 \
            || fingerprint_from_helper "$empty_helper" "$REPO" >/dev/null 2>&1 \
            || fingerprint_from_helper "$failed_helper" "$REPO" >/dev/null 2>&1 \
            || fingerprint_from_helper "$invalid_helper" "$REPO" >/dev/null 2>&1; then
        rm -f "$empty_helper" "$failed_helper" "$invalid_helper"
        return 1
    fi
    rm -f "$empty_helper" "$failed_helper" "$invalid_helper"
}

git_state() {
    /usr/bin/git -C "$REPO" rev-parse HEAD 2>/dev/null
}

dirty_hash() {
    /usr/bin/git -C "$REPO" status --porcelain 2>/dev/null \
        | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1
}

json_escape() { /usr/bin/python3 -I -c 'import json,sys; print(json.dumps(sys.stdin.read()))'; }

declare -A SUITE_STATUS
declare -A SUITE_NOTE

record() { # suite status note
    local suite="$1" status="$2" note="${3:-}" requested="$2"
    if [ "$status" = PASS ] && ! assert_source_unchanged "suite:$suite:after"; then
        status=FAIL
        note="${SOURCE_DRIFT_NOTE:-source changed during run}"
    fi
    SUITE_STATUS["$suite"]="$status"
    SUITE_NOTE["$suite"]="$note"
    echo "[$suite] $status $note"
    [ "$requested" = "$status" ]
}

# Successful real-client suites deliberately leave Minecraft running until
# their EXIT trap tears down the process group. Bash job control can therefore
# append `Killed ... runClient` AFTER result.json and the suite's explicit
# success echo. Blind `tail -1` made that planned cleanup look like a crash in
# otherwise-green manifests. Require the suite-owned success marker instead;
# an exit code of zero without that marker is not silently accepted.
explicit_success_note() { # log fixed-marker
    local log="$1" marker="$2" line
    line=$(grep -F "$marker" "$log" 2>/dev/null | tail -1)
    [ -n "$line" ] || return 1
    printf '%s\n' "$line"
}

cmd_note_selftest() {
    local log got rc=0
    log=$(mktemp)
    printf '%s\n' \
        'client boot ok under Xvfb; screenshot: shots/screenshot-title.png' \
        'client_boot.sh: line 18: 123 Killed runClient' > "$log"
    got=$(explicit_success_note "$log" 'client boot ok under Xvfb;') || rc=1
    [ "$got" = 'client boot ok under Xvfb; screenshot: shots/screenshot-title.png' ] || rc=1
    if explicit_success_note "$log" 'playtest ok:' >/dev/null; then rc=1; fi
    rm -f "$log"
    if [ "$rc" -ne 0 ]; then
        echo "FAIL: explicit success-note selection accepted teardown noise or a missing marker"
        return 1
    fi
    echo "PASS: explicit success-note selection ignores trailing teardown noise and rejects a missing marker"
}

previous_green_streak() { # <latest-manifest> <current-fingerprint>
    local latest="$1" fp="$2" value
    value=$(/usr/bin/python3 -I "$QA/scripts/validate_full_manifest.py" \
        "$latest" "$REPORTS" "$ARTIFACTS" "$fp" "$PROTOCOL_VERSION" 0 \
        "${EXPECTED_FULL_SUITES[@]}" 2>/dev/null) || value=0
    [[ "$value" =~ ^(0|[1-9][0-9]{0,6})$ ]] || return 1
    [ "$value" -le 1000000 ] || return 1
    printf '%s\n' "$value"
}

manifest_metadata_value_is_safe() { # value
    local value="$1"
    [ -n "$value" ] \
        && [ "${#value}" -le 256 ] \
        && [[ "$value" != *$'\r'* ]] \
        && [[ "$value" != *$'\n'* ]]
}

read_gradle_property() { # <gradle.properties> <exact-key>
    # Normalize only a physical CRLF line terminator. Duplicate keys, a bare
    # or embedded CR, invalid UTF-8 and oversized values are all ambiguous and
    # therefore fail closed instead of being silently collapsed by grep.
    /usr/bin/python3 -I - "$1" "$2" <<'PYEOF'
import pathlib
import re
import sys

path, key = sys.argv[1:]
if not re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", key):
    raise SystemExit(2)
data = pathlib.Path(path).read_bytes()
if len(data) > 1024 * 1024 or b"\0" in data:
    raise SystemExit(2)
prefix = key.encode("ascii") + b"="
matches = []
physical_lines = data.split(b"\n")
for index, physical_line in enumerate(physical_lines):
    # Only a CR immediately followed by the LF delimiter is a CRLF terminator.
    # A terminal/bare CR remains in the value and is rejected below.
    if index < len(physical_lines) - 1 and physical_line.endswith(b"\r"):
        physical_line = physical_line[:-1]
    if b"\r" in physical_line:
        raise SystemExit(2)
    if physical_line.startswith(prefix):
        matches.append(physical_line[len(prefix):])
if len(matches) != 1:
    raise SystemExit(2)
value = matches[0].decode("utf-8", errors="strict")
if not value or len(value) > 256 or "\r" in value or "\n" in value:
    raise SystemExit(2)
print(value)
PYEOF
}

write_manifest() { # overall
    local overall="$1"
    local fp="$START_FINGERPRINT" publish_latest=1
    local manifest_error=''
    local git_commit_value dirty_hash_value neoforge_value java_value mod_value
    local suite actual_count
    local -a manifest_arguments=()
    if ! assert_source_unchanged manifest; then
        overall=FAIL
        publish_latest=0
        echo "FATAL: ${SOURCE_DRIFT_NOTE:-source changed during run}; latest.json not updated" >&2
    fi
    local prev_streak=0
    if [ -f "$REPORTS/latest.json" ]; then
        prev_streak=$(previous_green_streak "$REPORTS/latest.json" "$fp") \
            || prev_streak=0
    fi
    local streak=0
    [ "$overall" = "PASS" ] && streak=$((prev_streak + 1))

    # Resolve every metadata field before entering Python and pass it as an
    # argv value. The old unquoted heredoc embedded command substitutions in
    # Python source; under `pipefail`, one metadata pipeline could make Bash
    # skip/fail the interpreter silently, leaving an old latest PASS in place.
    # A quoted heredoc plus checked argv has no shell-code expansion seam.
    if ! git_commit_value=$(git_state) \
            || ! dirty_hash_value=$(dirty_hash) \
            || ! neoforge_value=$(read_gradle_property \
                "$MOD/gradle.properties" neoforge_version) \
            || ! java_value=$(/usr/bin/java -version 2>&1) \
            || ! mod_value=$(read_gradle_property \
                "$MOD/gradle.properties" mod_version); then
        ensure_gate_red || true
        echo "FATAL: manifest metadata could not be resolved exactly" >&2
        return 1
    fi
    java_value="${java_value%%$'\n'*}"
    java_value="${java_value//\"/}"
    [[ "$git_commit_value" =~ ^[0-9a-f]{40,64}$ ]] \
        && [[ "$dirty_hash_value" =~ ^[0-9a-f]{64}$ ]] \
        && manifest_metadata_value_is_safe "$neoforge_value" \
        && manifest_metadata_value_is_safe "$java_value" \
        && manifest_metadata_value_is_safe "$mod_value" \
        || {
            ensure_gate_red || true
            echo "FATAL: manifest metadata was malformed" >&2
            return 1
        }

    actual_count=${#SUITE_STATUS[@]}
    manifest_arguments=(
        "$overall" "$fp" "$streak" "$publish_latest"
        "$QA/scripts/source_fingerprint.sh" "$REPO" "$PROTOCOL_VERSION"
        "$git_commit_value" "$dirty_hash_value" "$neoforge_value"
        "$java_value" "$mod_value" "$TS" "$RUN_DIR" "$REPORTS"
        "${#EXPECTED_FULL_SUITES[@]}" "${EXPECTED_FULL_SUITES[@]}"
        "$actual_count"
    )
    for suite in "${!SUITE_STATUS[@]}"; do
        manifest_arguments+=("$suite" "${SUITE_STATUS[$suite]}" \
            "${SUITE_NOTE[$suite]}")
    done

    local manifest_status=0
    manifest_error=$(/usr/bin/mktemp "$RUN_DIR/.manifest-publish.XXXXXX") \
        || {
            ensure_gate_red || true
            echo "FATAL: could not reserve manifest error transcript" >&2
            return 1
        }
    /usr/bin/python3 -I - "${manifest_arguments[@]}" \
            2> "$manifest_error" <<'PYEOF' \
        || manifest_status=$?
import json
import os
import re
import subprocess
import sys
import time

values = sys.argv[1:]
position = 0

def take():
    global position
    if position >= len(values):
        raise RuntimeError("truncated manifest argv")
    value = values[position]
    position += 1
    return value

overall = take()
fp = take()
streak = int(take())
publish_latest = take() == "1"
helper = take()
repo = take()
protocol = take()
git_commit = take()
dirty_hash_value = take()
neoforge = take()
java = take()
mod_version = take()
started = take()
run_dir = take()
reports = take()
expected_count = int(take())
expected_order = [take() for _ in range(expected_count)]
expected_suites = set(expected_order)
if len(expected_suites) != expected_count:
    raise RuntimeError("duplicate expected suite")
actual_count = int(take())
suites = {}
for _ in range(actual_count):
    name, status, note = take(), take(), take()
    if name in suites:
        raise RuntimeError(f"duplicate actual suite {name}")
    suites[name] = {"status": status, "note": note}
if position != len(values):
    raise RuntimeError("extra manifest argv")

def current_fingerprint():
    value = subprocess.check_output(
        ["/bin/bash", "--noprofile", "--norc", "-p", helper, repo],
        text=True,
        env={
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "HOME": "/tmp",
            "LANG": "C.UTF-8",
            "LC_ALL": "C",
            "TMPDIR": "/tmp",
        },
    ).strip()
    if not re.fullmatch(r"[0-9a-f]{64}", value):
        raise RuntimeError("invalid current fingerprint")
    return value

if set(suites) != expected_suites:
    raise RuntimeError(
        f"full suite roster mismatch missing={sorted(expected_suites-set(suites))} "
        f"extra={sorted(set(suites)-expected_suites)}"
    )
bad = {name: row.get("status") for name, row in suites.items()
       if (name != "visual" and row.get("status") != "PASS")
       or (name == "visual" and row.get("status") not in {"PASS", "BLOCKED"})}
derived = "PASS" if not bad else "FAIL"
if overall != derived:
    raise RuntimeError(f"overall {overall} disagrees with suite statuses {bad}")
manifest = {
    "protocol_version": protocol,
    "fingerprint": fp,
    "git_commit": git_commit,
    "dirty_hash": dirty_hash_value,
    "minecraft": "1.21.1",
    "neoforge": neoforge,
    "java": java,
    "mod_version": mod_version,
    "started": started,
    "finished": time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()),
    "suites": suites,
    "overall": overall,
    "green_streak": streak,
    "artifacts": run_dir,
}
os.makedirs(run_dir, exist_ok=True)
path = os.path.join(run_dir, "manifest.json")
if current_fingerprint() != fp:
    sys.exit(86)
temporary_run = path + ".tmp-" + str(os.getpid())
with open(temporary_run, "w") as handle:
    json.dump(manifest, handle, indent=2)
os.replace(temporary_run, path)
if publish_latest:
    if current_fingerprint() != fp:
        manifest["overall"] = "FAIL"
        manifest["green_streak"] = 0
        manifest["source_changed_during_run"] = True
        temporary_run = path + ".tmp-drift-" + str(os.getpid())
        with open(temporary_run, "w") as handle:
            json.dump(manifest, handle, indent=2)
        os.replace(temporary_run, path)
        sys.exit(86)
    latest = os.path.join(reports, "latest.json")
    temporary = latest + ".tmp-" + str(os.getpid())
    with open(temporary, "w") as handle:
        json.dump(manifest, handle, indent=2)
    os.replace(temporary, latest)
print("manifest:", path, "overall:", overall, "green_streak:", streak)
PYEOF
    if [ "$manifest_status" -ne 0 ]; then
        [ ! -s "$manifest_error" ] \
            || /usr/bin/sed 's/^/  manifest: /' "$manifest_error" >&2
        /usr/bin/rm -f -- "$manifest_error"
        ensure_gate_red || true
        if [ "$manifest_status" -eq 86 ]; then
            SOURCE_DRIFT=1
            SOURCE_DRIFT_NOTE="source changed inside manifest publish window"
        fi
        echo "FATAL: manifest publication failed (status $manifest_status); latest PASS not accepted" >&2
        return 1
    fi
    /usr/bin/rm -f -- "$manifest_error"
    if [ "$overall" = "PASS" ] && [ "$publish_latest" -eq 1 ]; then
        clear_full_attempt_marker || {
            echo "FATAL: PASS manifest published but stale/in-progress marker was corrupt or could not be cleared" >&2
            quarantine_own_latest
            return 1
        }
    fi
    [ "$overall" = PASS ]
}

