cmd_release_client_gate() { # run + external seal/key/PRECOMMIT values
    release_client_gate_argument_contract "$@" || {
        echo "usage: tools/hearthstead-qa release-client-gate <run-directory> --input-seal <external-ledger> --operator-key-file <external-key> --expected-operator-key-sha256 <sha256> --expected-precommit-session-nonce <64-hex> --expected-precommit-run-directory-token <64-hex> --expected-precommit-jar-sha256 <sha256> --expected-precommit-world-id <world-id>" >&2
        return 2
    }
    local release_root requested canonical current_fingerprint final_fingerprint
    local input_seal operator_key operator_key_sha256 precommit_nonce
    local precommit_run_directory_token precommit_jar_sha256 precommit_world_id
    local validator_status
    requested="$1"
    input_seal="$3"
    operator_key="$5"
    operator_key_sha256="$7"
    precommit_nonce="$9"
    precommit_run_directory_token="${11}"
    precommit_jar_sha256="${13}"
    precommit_world_id="${15}"
    release_root=$(/usr/bin/realpath -e -- "$ARTIFACTS/release-client" 2>/dev/null) || {
        echo "RELEASE CLIENT GATE: FAIL — no release-client evidence root" >&2
        return 1
    }
    [ -d "$release_root" ] && [ ! -L "$release_root" ] || {
        echo "RELEASE CLIENT GATE: FAIL — unsafe release-client evidence root" >&2
        return 1
    }
    case "$requested" in
        /*) ;;
        *[!A-Za-z0-9._-]*|'')
            echo "RELEASE CLIENT GATE: FAIL — unsafe run-directory name" >&2
            return 1;;
        *) requested="$release_root/$requested";;
    esac
    canonical=$(/usr/bin/realpath -e -- "$requested" 2>/dev/null) || {
        echo "RELEASE CLIENT GATE: FAIL — evidence directory is unavailable" >&2
        return 1
    }
    case "$canonical" in
        "$release_root"/*) ;;
        *)
            echo "RELEASE CLIENT GATE: FAIL — evidence directory is outside release-client" >&2
            return 1;;
    esac
    [ -d "$canonical" ] && [ ! -L "$canonical" ] || {
        echo "RELEASE CLIENT GATE: FAIL — evidence target is not a plain directory" >&2
        return 1
    }
    current_fingerprint=$(fingerprint) || {
        echo "RELEASE CLIENT GATE: FAIL — current source fingerprint unavailable" >&2
        return 1
    }
    /usr/bin/python3 -I "$QA/scripts/validate_release_client_evidence.py" \
        "$canonical" --expected-source-fingerprint "$current_fingerprint" \
        --input-seal "$input_seal" \
        --operator-key-file "$operator_key" \
        --expected-operator-key-sha256 "$operator_key_sha256" \
        --expected-precommit-session-nonce "$precommit_nonce" \
        --expected-precommit-run-directory-token "$precommit_run_directory_token" \
        --expected-precommit-jar-sha256 "$precommit_jar_sha256" \
        --expected-precommit-world-id "$precommit_world_id"
    validator_status=$?
    final_fingerprint=$(fingerprint) || {
        echo "RELEASE CLIENT GATE: FAIL — final source fingerprint unavailable" >&2
        return 1
    }
    if [ "$final_fingerprint" != "$current_fingerprint" ]; then
        echo "RELEASE CLIENT GATE: FAIL — source changed while native evidence was validated" >&2
        return 1
    fi
    return "$validator_status"
}

