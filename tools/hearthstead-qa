cmd_provision() { # AC-10: rebuild the shared install from scratch, prove it with playtest
    # Finding 5: durable transcript + verdict, same evidence layout as every
    # other scenario — this used to be stored nowhere once the invoking
    # process exited.
    ev_init "provision"
    local install_dir backup restore_ok=1
    if ! install_dir=$(hsqa_safe_target \
            "${HSQA_INSTALL_DIR:-/tmp/claude-0/hsqa-install-v2}" \
            "provision install"); then
        check_fail provision "unsafe HSQA_INSTALL_DIR; refusing provision"
        finish_result FAIL
        return 1
    fi
    if ! backup=$(hsqa_safe_target \
            "${install_dir}.bak-$(date -u +%Y%m%dT%H%M%SZ)" \
            "provision backup"); then
        check_fail provision "unsafe provision backup path"
        finish_result FAIL
        return 1
    fi
    if [ -e "$backup" ]; then
        check_fail provision "backup target already exists: $backup"
        finish_result FAIL
        return 1
    fi
    if [ -e "$install_dir" ]; then
        hsqa_claim_empty_directory \
            "$install_dir" .hsqa-install-owned hsqa-install-v1 \
            || { check_fail provision "refusing unowned install $install_dir"; finish_result FAIL; return 1; }
        hsqa_require_owned_directory \
            "$install_dir" .hsqa-install-owned hsqa-install-v1 \
            || { check_fail provision "invalid install ownership marker"; finish_result FAIL; return 1; }
        mv -- "$install_dir" "$backup" \
            || { check_fail provision "could not move owned install to backup"; finish_result FAIL; return 1; }
        echo "provision: moved existing install aside to $backup" | tee -a "$EV_LOGS/provision.log"
    fi
    if ! /bin/bash --noprofile --norc -p "$QA/scripts/server_install.sh" "$MOD" --force > "$EV_LOGS/install.log" 2>&1; then
        echo "provision: FAIL — reinstall failed" | tee -a "$EV_LOGS/provision.log"
        if [ -d "$backup" ]; then
            hsqa_require_owned_directory \
                "$backup" .hsqa-install-owned hsqa-install-v1 \
                || restore_ok=0
            if [ -e "$install_dir" ]; then
                hsqa_require_owned_directory \
                    "$install_dir" .hsqa-install-owned hsqa-install-v1 \
                    || restore_ok=0
                if [ "$restore_ok" -eq 1 ]; then
                    rm -rf -- "$install_dir" || restore_ok=0
                fi
            fi
            if [ "$restore_ok" -eq 1 ]; then
                mv -- "$backup" "$install_dir" || restore_ok=0
            fi
            if [ "$restore_ok" -eq 1 ]; then
                echo "provision: restored owned backup (install could not be verified)" \
                    | tee -a "$EV_LOGS/provision.log"
            else
                echo "provision: could not safely restore backup; preserved paths for manual inspection" \
                    | tee -a "$EV_LOGS/provision.log"
            fi
        fi
        check_fail provision "reinstall failed — see logs/install.log"
        finish_result FAIL
        write_reproduction "# Reproduce: provision
tools/hearthstead-qa provision
Verdict: FAIL — reinstall failed. See logs/install.log
"
        return 1
    fi
    check_pass reinstall "shared install rebuilt from scratch — see logs/install.log"
    suite_playtest
    if [ "${SUITE_STATUS[playtest]:-}" = "PASS" ]; then
        if [ -d "$backup" ]; then
            hsqa_require_owned_directory \
                "$backup" .hsqa-install-owned hsqa-install-v1 \
                || { check_fail provision "refusing to delete unowned backup $backup"; finish_result FAIL; return 1; }
            rm -rf -- "$backup" \
                || { check_fail provision "could not delete verified backup $backup"; finish_result FAIL; return 1; }
        fi
        echo "provision: PASS — rebuilt install verified by a passing playtest; backup deleted" | tee -a "$EV_LOGS/provision.log"
        check_pass verify_playtest "playtest PASSED against the rebuilt install — see $RUN_DIR/playtest.log"
        finish_result PASS
        write_reproduction "# Reproduce: provision
tools/hearthstead-qa provision
Verdict: PASS — rebuilt install verified by playtest ($RUN_DIR)
"
        return 0
    else
        echo "provision: FAIL — rebuilt install did not pass playtest; backup kept at $backup for comparison" | tee -a "$EV_LOGS/provision.log"
        check_fail verify_playtest "playtest did not PASS against the rebuilt install — see $RUN_DIR/playtest.log; backup kept at $backup"
        finish_result FAIL
        write_reproduction "# Reproduce: provision
tools/hearthstead-qa provision
Verdict: FAIL — rebuilt install did not pass playtest. Backup kept at $backup
"
        return 1
    fi
}

export HSQA_REPORTS="$REPORTS" HSQA_PROTO="$PROTOCOL_VERSION"

# The controller and scenario harness both validate the one shared helper's
# output, and PROTOCOL.md requires exact equality because a manifest fingerprint
# is only meaningful if it is comparable to latest.json's. Until now nothing
# CHECKED that, and the requirement was a comment. Adding the controller
# itself to the fingerprint (2026-08-26, KF-024) changed one of the two and
# nearly drifted them silently; the near-miss is the reason this exists.
# A judge whose two clocks disagree cannot tell whether anything changed, so
# it refuses to sit rather than guess.
assert_fingerprint_twins() {
    local a b
    if ! a="$(fingerprint)"; then
        echo "FATAL: controller source fingerprint failed or was not 64 lowercase hex" >&2
        exit 2
    fi
    if ! b="$(HSQA_REPO="$REPO" hsqa_fingerprint)"; then
        echo "FATAL: scenario source fingerprint failed or was not 64 lowercase hex" >&2
        exit 2
    fi
    if [ "$a" != "$b" ]; then
        echo "FATAL: the two fingerprint implementations disagree." >&2
        echo "  tools/hearthstead-qa   : $a" >&2
        echo "  qa/scripts/lib_harness : $b" >&2
        echo "They must stay byte-for-byte equivalent (qa/PROTOCOL.md)." >&2
        echo "Fix the drift before any suite runs -- every manifest written" >&2
        echo "while they disagree records a fingerprint nothing can compare." >&2
        exit 2
    fi
}
assert_fingerprint_twins
if ! START_FINGERPRINT="$(fingerprint)" \
        || ! [[ "$START_FINGERPRINT" =~ ^[0-9a-f]{64}$ ]]; then
    echo "FATAL: could not capture controller start fingerprint" >&2
    exit 2
fi
SOURCE_DRIFT=0
SOURCE_DRIFT_NOTE=''
quarantine_own_latest() {
    /usr/bin/python3 -I - "$REPORTS/latest.json" "$RUN_DIR" <<'PYEOF' || true
import json, os, sys
latest, run_dir = sys.argv[1], sys.argv[2]
run_manifest = os.path.join(run_dir, "manifest.json")
try:
    with open(run_manifest) as handle:
        manifest = json.load(handle)
    manifest["overall"] = "FAIL"
    manifest["green_streak"] = 0
    manifest["source_changed_during_run"] = True
    temporary = run_manifest + ".tmp-quarantine-" + str(os.getpid())
    with open(temporary, "w") as handle:
        json.dump(manifest, handle, indent=2)
    os.replace(temporary, run_manifest)
except Exception:
    pass
try:
    with open(latest) as handle:
        candidate = json.load(handle)
    if candidate.get("artifacts") == run_dir:
        destination = os.path.join(run_dir, "latest-quarantined-source-drift.json")
        os.replace(latest, destination)
except Exception:
    pass
PYEOF
    ensure_gate_red || true
}
controller_exit_guard() {
    local status=$?
    local cleanup_status=0
    trap - EXIT
    if [ -n "${CONTROLLER_CHILD_RECORD:-}" ]; then
        controller_child_cleanup || cleanup_status=1
    elif [ -n "${CONTROLLER_CHILD_PGID:-}" ] \
            && kill -0 -- "-${CONTROLLER_CHILD_PGID}" 2>/dev/null; then
        cleanup_status=1
    fi
    if [ "$cleanup_status" -ne 0 ]; then
        echo "FATAL: controller exit could not prove exact child-group absence; recovery record retained" >&2
        exit 125
    fi
    if [ "$CONTROLLER_MUTATES" -eq 1 ] \
            && ! assert_source_unchanged controller_exit; then
        quarantine_own_latest
        echo "FATAL: ${SOURCE_DRIFT_NOTE:-source changed before controller exit}" >&2
        exit 86
    fi
    exit "$status"
}
trap controller_exit_guard EXIT

case "${1:-help}" in
    # Every single-suite command must EXIT NON-ZERO on failure: a caller that
    # checks $? (CI, a wrapper script, a human) must never read a red suite as
    # success just because it ran. AC-12: single-suite commands NEVER write
    # qa/reports/latest.json or clear .stale — that would let `doctor` alone
    # turn a red gate green. ONLY `full` (a full-scope run) may do that; its
    # green_streak only increments on a full-scope PASS.
    doctor)      suite_doctor; [ "${SUITE_STATUS[doctor]}" = PASS ];;
    changed)     cmd_changed;;
    validate)    suite_assets;;
    animation)   suite_animation;;
    gametest)    suite_gametest; [ "${SUITE_STATUS[gametest]}" = PASS ];;
    behavior)    suite_behavior; [ "${SUITE_STATUS[behavior]}" = PASS ];;
    dedicated)   suite_dedicated; [ "${SUITE_STATUS[dedicated]}" = PASS ];;
    blessing-restart) suite_blessing_restart; [ "${SUITE_STATUS[blessing_restart]}" = PASS ];;
    performance) suite_performance; [ "${SUITE_STATUS[performance]}" = PASS ];;
    client)      suite_client; [ "${SUITE_STATUS[client]}" != FAIL ];;
    playtest)    suite_playtest; [ "${SUITE_STATUS[playtest]}" != FAIL ];;
    visual)      suite_visual; [ "${SUITE_STATUS[visual]}" != FAIL ];;
    live)
        echo "FATAL: legacy live.sh is disabled until its tmux/client launchers use the exact tracked-process contract." >&2
        echo "Use the bounded 'playtest' suite for current QA evidence." >&2
        exit 2;;
    reap)        shift; /bin/bash --noprofile --norc -p "$QA/scripts/reap.sh" "$@";;
    negative)    shift; /bin/bash --noprofile --norc -p "$QA/scripts/negative_tests.sh" "$@";;
    note-selftest) cmd_note_selftest;;
    startup-selftest)
        controller_startup_hermeticity_selftest \
            && echo "controller startup hermeticity selftest: PASS";;
    controller-contract-selftest)
        [ "$#" -le 2 ] || exit 2
        controller_contract_selftest "${2:-all}";;
    provision)   cmd_provision;;
    fast)
        # The iteration gate: every check that does NOT boot a Minecraft
        # client, in one command. Measured on this machine: doctor+assets+
        # animation ~5s, build ~5s, gametest ~21s, behavior ~20s -- about a
        # minute, against ~13 for `full`. That gap is entirely the four
        # client/server-booting suites (dedicated ~2m33, performance ~2m06,
        # client ~24s, playtest ~5m29), which is why they are NOT here.
        #
        # `fast` runs REAL tests: the whole GameTest suite and the
        # decision-trace behaviour analysis both execute the mod in a real
        # server. What it cannot see is anything that only exists on the
        # client or in a live world -- rendering, animation-in-motion, UI,
        # sound, chunk/world interaction, restart persistence, MSPT budget.
        #
        # Like every non-`full` command it NEVER writes latest.json and
        # NEVER clears .stale (AC-12): a green `fast` is iteration
        # confidence, never completion evidence. Completion still requires
        # `full` twice at one fingerprint.
        overall=PASS
        suite_doctor    || overall=FAIL
        suite_assets    || overall=FAIL
        suite_animation || overall=FAIL
        suite_build     || overall=FAIL
        suite_gametest  || overall=FAIL
        suite_behavior  || overall=FAIL
        echo "FAST: $overall (no client boot — completion still requires 'full' x2 + 'gate')"
        [ "$overall" = "PASS" ];;
    quick)
        # The one-command iteration check: compile, asset validators, the
        # animation contract checker, then the changed-file advisory. Runs
        # no game and never writes latest.json (AC-12) — a green `quick` is
        # iteration feedback, NEVER completion evidence (the gate needs
        # `full` twice at one fingerprint).
        overall=PASS
        suite_build     || overall=FAIL
        suite_assets    || overall=FAIL
        suite_animation || overall=FAIL
        cmd_changed || true
        echo "QUICK: $overall (cheap checks only — completion still requires 'full' x2 + 'gate')"
        [ "$overall" = PASS ];;
    full)
        rm -f "$REPORTS/BLOCKED"   # a full run supersedes any documented blocker
        if ! harness_cleanliness_check > "$RUN_DIR/cleanliness-preflight.log" 2>&1; then
            echo "FULL: FAIL — residual QA state exists before the first suite; see $RUN_DIR/cleanliness-preflight.log" >&2
            exit 1
        fi
        overall=PASS
        suite_doctor      || overall=FAIL
        suite_assets      || overall=FAIL
        suite_animation   || overall=FAIL
        suite_build       || overall=FAIL
        suite_gametest    || overall=FAIL
        suite_behavior    || overall=FAIL
        suite_dedicated   || overall=FAIL
        suite_blessing_restart || overall=FAIL
        suite_performance || overall=FAIL
        suite_client      || overall=FAIL
        suite_playtest    || overall=FAIL
        suite_visual      || true   # BLOCKED allowed, FAIL not
        [ "${SUITE_STATUS[visual]}" = FAIL ] && overall=FAIL
        if ! harness_cleanliness_check > "$RUN_DIR/cleanliness-final.log" 2>&1; then
            echo "FULL: FAIL — a suite left residual QA state; see $RUN_DIR/cleanliness-final.log" >&2
            overall=FAIL
        fi
        if [ "$overall" = PASS ]; then
            write_manifest "$overall" || overall=FAIL
        fi
        [ "$overall" = PASS ];;
    gate)        cmd_gate;;
    release-client-gate) shift; cmd_release_client_gate "$@";;
    status)      cmd_status;;
    reproduce)   shift; cmd_reproduce "${1:-}";;
    *) sed -n '1,3p' "$0"; echo "commands: quick fast doctor changed validate animation gametest behavior dedicated blessing-restart performance client playtest visual provision reap negative note-selftest startup-selftest controller-contract-selftest full gate release-client-gate status reproduce"; echo "release-client-gate requires an external input seal, separate operator key, and the exact externally posted PRECOMMIT hashes/nonce/world id"; echo "new here? read qa/QUICKSTART.md";;
esac
