# GameTests must start from an EMPTY world, every time.
#
# They did not, until 2026-08-26. `runGameTestServer` reuses
# hearthstead-neoforge/run/world, and nothing ever cleared it: the main
# tree's had grown to 217 MB of accumulated settlements, buildings and
# entities dating back to 23 August, and a fresh worktree reached 14 MB in
# two runs. FLAKE-2 measured the growth directly across two back-to-back
# invocations with no code change --
# run/world/data/hearthstead_settlements.dat 52080 -> 65905 bytes, poi
# region files 28 -> 34.
#
# That is not untidiness, it is the reproducibility bug. BuildingManager
# sweeps ONE building per 20 ticks across every settlement in the save and
# dissolves any whose plaque block is missing (D-005, correctly). Which
# building the cursor reaches in a given test's lifetime depends on how many
# buildings the save holds -- 441 in one run FLAKE-2 instrumented -- so a
# suite carrying yesterday's buildings gives a different answer than one
# starting clean, and the same commit produced 1, 12, 14 and 20 red tonight.
# A run whose result depends on what the last run left behind cannot gate
# anything.
#
# Only `world` is removed. mods/, config/ and server.properties are the
# installation, not the state under test.
CONTROLLER_CHILD_ROLE=''
CONTROLLER_CHILD_PID=''
CONTROLLER_CHILD_PGID=''
CONTROLLER_CHILD_RECORD=''

controller_child_cleanup() {
    local cleanup_status=0
    if [ -n "$CONTROLLER_CHILD_RECORD" ]; then
        hsqa_stop_tracked "$CONTROLLER_CHILD_ROLE" "$CONTROLLER_CHILD_RECORD" \
            || cleanup_status=1
    fi
    if [ "$cleanup_status" -eq 0 ]; then
        CONTROLLER_CHILD_ROLE=''
        CONTROLLER_CHILD_PID=''
        CONTROLLER_CHILD_PGID=''
        CONTROLLER_CHILD_RECORD=''
    fi
    return "$cleanup_status"
}

controller_child_signal() { # <130|143>
    local signal_status="${1:-125}" cleanup_status=0
    trap - INT TERM
    controller_child_cleanup || cleanup_status=1
    if [ "$cleanup_status" -ne 0 ]; then
        echo "FATAL: controller interrupt could not prove exact child-group absence; recovery record retained" >&2
        exit 125
    fi
    exit "$signal_status"
}

run_controller_tracked_group() { # <role> <identity> <command> [args...]
    local role="$1" identity="$2" launch_status child_status cleanup_status=0
    shift 2
    if [ -n "$CONTROLLER_CHILD_RECORD" ] \
            || { [ -n "$CONTROLLER_CHILD_PGID" ] \
                && kill -0 -- "-$CONTROLLER_CHILD_PGID" 2>/dev/null; }; then
        echo "FATAL: refusing a second controller child while prior recovery authority remains" >&2
        return 125
    fi
    CONTROLLER_CHILD_ROLE="$role"
    CONTROLLER_CHILD_PID=''
    CONTROLLER_CHILD_PGID=''
    CONTROLLER_CHILD_RECORD=''
    hsqa_launch_tracked_group "$role" "$identity" controller_child_signal \
        CONTROLLER_CHILD_PID CONTROLLER_CHILD_PGID CONTROLLER_CHILD_RECORD \
        CONTROLLER_CHILD_ROLE \
        "$@"
    launch_status=$?
    if [ "$launch_status" -ne 0 ]; then
        if [ -n "$CONTROLLER_CHILD_RECORD" ]; then
            controller_child_cleanup || return 125
        elif [ -z "$CONTROLLER_CHILD_PGID" ] \
                || ! kill -0 -- "-$CONTROLLER_CHILD_PGID" 2>/dev/null; then
            CONTROLLER_CHILD_ROLE=''
            CONTROLLER_CHILD_PID=''
            CONTROLLER_CHILD_PGID=''
            CONTROLLER_CHILD_RECORD=''
        fi
        return "$launch_status"
    fi
    wait "$CONTROLLER_CHILD_PID"
    child_status=$?
    controller_child_cleanup || cleanup_status=1
    [ "$cleanup_status" -eq 0 ] || return 125
    return "$child_status"
}

run_normal_gametest_process() { # <identity> <log> [trace-file]
    local identity="$1" log="$2" trace="${3:-}"
    if [ -n "$trace" ]; then
