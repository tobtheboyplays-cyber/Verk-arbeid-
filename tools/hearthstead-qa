normal_gametest_verdict() { # <log>
    local log="$1" exact_count any_count success_tokens failure_tokens
    exact_count=$(grep -cE \
        "^[[:space:]]*\[[^]]+\] \[Server thread/INFO\] \[(minecraft/GameTestServer|net\\.minecraft\\.gametest\\.framework\\.GameTestServer/)\]: All $EXPECTED_REQUIRED_GAMETESTS required tests passed :\\)$" \
        "$log" 2>/dev/null || true)
    any_count=$(grep -cE \
        '^[[:space:]]*\[[^]]+\] \[Server thread/INFO\] \[(minecraft/GameTestServer|net\.minecraft\.gametest\.framework\.GameTestServer/)\]: All [0-9]+ required tests passed :\)$' \
        "$log" 2>/dev/null || true)
    # The canonical success emitter is deliberately case-exact, but every
    # success/failure token family is counted case-insensitively. Otherwise a
    # second malformed trusted summary such as `REQUIRED TESTS PASSED` could
    # coexist with the canonical line and leave this judge falsely green.
    success_tokens=$(grep -Eic 'required[[:space:]]+tests[[:space:]]+passed' \
        "$log" 2>/dev/null || true)
    failure_tokens=$(grep -Eic 'required[[:space:]]+tests[[:space:]]+failed' \
        "$log" 2>/dev/null || true)
    [ "$exact_count" -eq 1 ] && [ "$any_count" -eq 1 ] \
        && [ "$success_tokens" -eq 1 ] && [ "$failure_tokens" -eq 0 ] \
        && ! grep -qiE \
            'hearthstead_active_perf|HSQA_ACTIVE_BLESSING_RESULT|active_blessing_scale_' \
            "$log" 2>/dev/null
}

