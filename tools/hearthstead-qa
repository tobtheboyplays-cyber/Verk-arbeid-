controller_startup_hermeticity_selftest() (
    local test_root='' sentinel hook output errors status=0 canonical quoted_sentinel
    cleanup_controller_startup_selftest() {
        local cleanup_status=$?
        trap - EXIT INT TERM
        if [ -n "$test_root" ]; then
            canonical=$(/usr/bin/realpath -m -- "$test_root") || exit 125
            case "$canonical" in /tmp/hsqa-controller-env.*) ;;
                *) exit 125;;
            esac
            [ "$canonical" = "$test_root" ] && [ -d "$test_root" ] \
                && [ ! -L "$test_root" ] || exit 125
            /usr/bin/rm -rf -- "$test_root" || exit 125
            [ ! -e "$test_root" ] && [ ! -L "$test_root" ] || exit 125
        fi
        exit "$cleanup_status"
    }
    trap cleanup_controller_startup_selftest EXIT INT TERM
    test_root=$(/usr/bin/mktemp -d /tmp/hsqa-controller-env.XXXXXX) || return 1
    test_root=$(/usr/bin/realpath -e -- "$test_root") || return 1
    /usr/bin/chmod 700 -- "$test_root" || return 1
    sentinel="$test_root/pre-controller-executed"
    hook="$test_root/bash-env"
    output="$test_root/stdout"
    errors="$test_root/stderr"
    /usr/bin/printf '/usr/bin/touch %q\n' "$sentinel" > "$hook" || return 1
    /usr/bin/mkdir -m 700 -- "$test_root/python" "$test_root/bin" || return 1
    /usr/bin/printf 'open("%s", "a").write("python-hook\\n")\n' \
        "$sentinel" > "$test_root/python/sitecustomize.py" || return 1
    /usr/bin/printf '#!/bin/sh\n/usr/bin/touch %q\nexit 94\n' "$sentinel" \
        > "$test_root/bin/python3" || return 1
    /usr/bin/chmod 700 -- "$test_root/bin/python3" || return 1

    # Exported functions are a second pre-script execution channel distinct
    # from BASH_ENV.  The controller's /bin/bash -p shebang must reject both
    # before any path, report, lock or process authority is accepted.
    quoted_sentinel=$(/usr/bin/printf '%q' "$sentinel") || return 1
    builtin eval "python3() { /usr/bin/touch $quoted_sentinel; return 95; }"
    builtin eval "realpath() { /usr/bin/touch $quoted_sentinel; return 96; }"
    builtin eval "bash() { /usr/bin/touch $quoted_sentinel; return 97; }"
    export -f python3 realpath bash
    /usr/bin/timeout --foreground --kill-after=2 30 \
        /usr/bin/env \
            "PATH=$test_root/bin" "HOME=$test_root/hostile-home" \
            "BASH_ENV=$hook" "ENV=$hook" "CDPATH=$test_root" \
            "PYTHONPATH=$test_root/python" \
            "PYTHONSTARTUP=$test_root/python/sitecustomize.py" \
            "PYTHONHOME=$test_root/python" PYTHONINSPECT=1 \
            PYTHONWARNINGS=error "SHELLOPTS=xtrace:braceexpand" \
            "BASHOPTS=extdebug:sourcepath" "PS4=$(/usr/bin/printf '%q' ': hostile ')" \
            "GLOBIGNORE=*" HSQA_REPO=/ HSQA_REPORTS=/ \
            HSQA_ARTIFACTS=/ HSQA_SAFE_TMP_ROOT=/ HSQA_PIDDIR=/ \
            HSQA_INST_ROOT=/ HSQA_INSTALL_DIR=/ \
            HSQA_CLIENT_INSTALL_DIR=/ HSQA_TMUX_SOCKET=/ \
            HSQA_GAMETEST_NAMESPACE=active HSQA_ENV_CLEANED=1 \
            "$CONTROLLER_PATH" help > "$output" 2> "$errors" \
        || status=$?
    if [ "$status" -eq 0 ] && [ ! -e "$sentinel" ] \
            && [ ! -L "$sentinel" ] && [ ! -s "$errors" ] \
            && /usr/bin/grep -q '^commands:' "$output"; then
        return 0
    fi
    echo "controller startup hermeticity selftest: FAIL status=$status sentinel=$([ -e "$sentinel" ] && echo present || echo absent)" >&2
    /usr/bin/sed 's/^/  stdout: /' "$output" >&2 2>/dev/null || true
    /usr/bin/sed 's/^/  stderr: /' "$errors" >&2 2>/dev/null || true
    return 1
)

controller_contract_selftest() { # [all|full-attempt|release-client-gate]
    # A focused, non-Minecraft entry point for the controller's own fail-closed
    # contracts. Keep it behind the host-global suite lock: cmd_gate observes
    # canonical process state even though every fixture artifact below lives in
    # an authenticated, disposable /tmp directory.
    local selection="${1:-all}" contract order
    if [ "$selection" = full-attempt ]; then
        if ! ( full_attempt_contract_selftest ); then
            echo "controller contract selftest: FAIL (targeted:full_attempt_contract_selftest)" >&2
            return 1
        fi
        echo "controller contract selftest: PASS (targeted full-attempt)"
        return 0
    fi
    if [ "$selection" = release-client-gate ]; then
        if ! ( release_client_gate_argument_contract_selftest ); then
            echo "controller contract selftest: FAIL (targeted:release_client_gate_argument_contract_selftest)" >&2
            return 1
        fi
        echo "controller contract selftest: PASS (targeted release-client-gate)"
        return 0
    fi
    [ "$selection" = all ] || {
        echo "controller contract selftest: invalid selection" >&2
        return 2
    }
    local -a original_order=(fingerprint_contract_selftest \
        manifest_contract_selftest previous_green_streak_selftest \
        full_attempt_contract_selftest normal_gametest_verdict_selftest \
        release_client_gate_argument_contract_selftest)
    local -a reversed_order=(normal_gametest_verdict_selftest \
        release_client_gate_argument_contract_selftest full_attempt_contract_selftest \
        previous_green_streak_selftest manifest_contract_selftest \
        fingerprint_contract_selftest)
    for order in original reversed; do
        local -n contract_order="${order}_order"
        for contract in "${contract_order[@]}"; do
            # Every contract gets a fresh process image. A PASS must never
            # depend on a prior selftest's globals, exported attributes,
            # function overrides, traps, umask or working directory.
            if ! ( "$contract" ); then
                echo "controller contract selftest: FAIL ($order:$contract)" >&2
                return 1
            fi
        done
        unset -n contract_order
    done
    echo "controller contract selftest: PASS (isolated original+reversed order)"
}

