gate_state_snapshot() { # read-only digest of every gate-deciding report entry
    /usr/bin/python3 -I - "$REPORTS" <<'PYEOF'
import hashlib, json, os, stat, sys

root = sys.argv[1]
digest = hashlib.sha256()

def add(value):
    digest.update(value.encode("utf-8", "surrogateescape"))
    digest.update(b"\0")

def describe(path, label, hash_bytes=False):
    add(label)
    try:
        value = os.lstat(path)
    except FileNotFoundError:
        add("ABSENT")
        return None
    except OSError as exc:
        raise SystemExit(f"snapshot failed for {label}: {exc}")
    add(f"{value.st_dev}:{value.st_ino}:{value.st_mode}:{value.st_nlink}:"
        f"{value.st_uid}:{value.st_size}:{value.st_mtime_ns}")
    if hash_bytes and stat.S_ISREG(value.st_mode):
        with open(path, "rb") as handle:
            add(hashlib.sha256(handle.read()).hexdigest())
    return value

root_stat = describe(root, "reports")
if root_stat is None or not stat.S_ISDIR(root_stat.st_mode):
    raise SystemExit("reports directory is absent or not a directory")
try:
    entries = sorted(os.listdir(root))
except OSError as exc:
    raise SystemExit(f"reports listing failed: {exc}")
for name in entries:
    add("entry:" + name)
    describe(os.path.join(root, name), "root:" + name,
             name in ("latest.json", "BLOCKED", ".stale"))

latest = os.path.join(root, "latest.json")
try:
    with open(latest, encoding="utf-8") as handle:
        data = json.load(handle)
    run = data.get("artifacts") if isinstance(data, dict) else None
except Exception:
    run = None
if isinstance(run, str):
    describe(run, "run-dir")
    if os.path.isdir(run) and not os.path.islink(run):
        try:
            for name in sorted(os.listdir(run)):
                add("run-entry:" + name)
                describe(os.path.join(run, name), "run:" + name,
                         name == "manifest.json")
        except OSError as exc:
            raise SystemExit(f"run listing failed: {exc}")
print(digest.hexdigest())
PYEOF
}

read_only_fixture_snapshot() { # <small fixture tree>; selftest metadata+byte proof
    /usr/bin/python3 -I - "$1" <<'PYEOF'
import hashlib, os, stat, sys
root = sys.argv[1]
digest = hashlib.sha256()
for current, dirs, files in os.walk(root, topdown=True, followlinks=False):
    dirs.sort(); files.sort()
    for name in ["."] + dirs + files:
        path = current if name == "." else os.path.join(current, name)
        relative = os.path.relpath(path, root)
        value = os.lstat(path)
        digest.update(relative.encode("utf-8", "surrogateescape") + b"\0")
        digest.update((f"{value.st_dev}:{value.st_ino}:{value.st_mode}:"
                       f"{value.st_nlink}:{value.st_uid}:{value.st_size}:"
                       f"{value.st_mtime_ns}").encode() + b"\0")
        if stat.S_ISREG(value.st_mode):
            with open(path, "rb") as handle:
                digest.update(hashlib.sha256(handle.read()).digest())
        elif stat.S_ISLNK(value.st_mode):
            digest.update(os.readlink(path).encode("utf-8", "surrogateescape"))
print(digest.hexdigest())
PYEOF
}

cmd_gate() {
    local fp final_fp state_before state_after
    if ! state_before="$(gate_state_snapshot)"; then
        echo "GATE: FAIL — report state could not be snapshotted safely" >&2
        return 2
    fi
    if ! fp="$(fingerprint)"; then
        echo "GATE: FAIL — source fingerprint could not be computed" >&2
        return 2
    fi
    # Documented-blocker escape: qa/reports/BLOCKED must contain the failing
    # command, error evidence, work completed and the exact resume action.
    # It permits stopping with an honest "NOT READY — BLOCKED" only; it is
    # deleted by the next full run so it cannot linger past the blocker.
    if [ -s "$REPORTS/BLOCKED" ]; then
        echo "GATE: BLOCKED — external blocker documented in qa/reports/BLOCKED."
        echo "Completion status is NOT READY — BLOCKED (never PASS). Contents:"
        sed 's/^/  | /' "$REPORTS/BLOCKED"
        return 2
    fi
    # AC-12: single-suite commands (doctor, dedicated, ...) never write
    # latest.json or clear .stale — only a full-scope `full` run may. So a
    # red/stale state with no latest.json means literally that: no
    # full-scope run exists yet, regardless of how many single suites ran.
    if [ -e "$REPORTS/.stale" ] || [ -L "$REPORTS/.stale" ]; then
        echo "GATE: FAIL — QA is stale or a full run is incomplete. Run: tools/hearthstead-qa full"
        return 2
    fi
    if [ ! -f "$REPORTS/latest.json" ]; then
        echo "GATE: FAIL — no current full-scope manifest exists. Run: tools/hearthstead-qa full"
        return 2
    fi
    if ! harness_cleanliness_check; then
        echo "GATE: FAIL — residual QA process, recovery record, session, display, or port detected."
        echo "Inspect with: tools/hearthstead-qa reap check"
        return 2
    fi
    local streak
    if ! streak=$(/usr/bin/python3 -I "$QA/scripts/validate_full_manifest.py" \
            "$REPORTS/latest.json" "$REPORTS" "$ARTIFACTS" \
            "$fp" "$PROTOCOL_VERSION" 2 "${EXPECTED_FULL_SUITES[@]}" 2>&1); then
        echo "GATE: FAIL — published full-run evidence is missing, unsafe, or inconsistent."
        printf ' - %s\n' "$streak"
        echo "Next: tools/hearthstead-qa full"
        return 2
    fi
    if [ -e "$REPORTS/.stale" ] || [ -L "$REPORTS/.stale" ] \
            || [ ! -f "$REPORTS/latest.json" ] \
            || [ -L "$REPORTS/latest.json" ]; then
        echo "GATE: FAIL — completion evidence changed during gate validation."
        return 2
    fi
    if ! state_after="$(gate_state_snapshot)" \
            || [ "$state_after" != "$state_before" ]; then
        echo "GATE: FAIL — report bytes/identity/entries changed during gate validation."
        return 2
    fi
    # The fingerprint must be the final fallible observation before PASS.
    # A source edit while the report snapshot is being computed used to land
    # after the old final fingerprint and could therefore publish stale green.
    # The dynamically-scoped test barrier is unset in production and exists
    # only inside full_attempt_contract_selftest's isolated fixture.
    if [ -n "${GATE_FINAL_FP_SELFTEST_READY:-}${GATE_FINAL_FP_SELFTEST_HOLD:-}" ]; then
        [ -n "${GATE_FINAL_FP_SELFTEST_READY:-}" ] \
            && [ -n "${GATE_FINAL_FP_SELFTEST_HOLD:-}" ] \
            || { echo "GATE: FAIL — malformed final-fingerprint test barrier."; return 2; }
        case "$GATE_FINAL_FP_SELFTEST_READY:$GATE_FINAL_FP_SELFTEST_HOLD" in
            /tmp/hsqa-full-attempt.*:/tmp/hsqa-full-attempt.*) ;;
            *) echo "GATE: FAIL — unsafe final-fingerprint test barrier."; return 2;;
        esac
        printf 'ready\n' > "$GATE_FINAL_FP_SELFTEST_READY" \
            || { echo "GATE: FAIL — final-fingerprint test barrier could not publish."; return 2; }
        local gate_pause_attempt
        for gate_pause_attempt in $(seq 1 500); do
            [ -e "$GATE_FINAL_FP_SELFTEST_HOLD" ] || break
            sleep 0.01
        done
        [ ! -e "$GATE_FINAL_FP_SELFTEST_HOLD" ] \
            || { echo "GATE: FAIL — final-fingerprint test barrier timed out."; return 2; }
    fi
    if ! final_fp="$(fingerprint)" \
            || ! [[ "$final_fp" =~ ^[0-9a-f]{64}$ ]] \
            || [ "$final_fp" != "$fp" ]; then
        echo "GATE: FAIL — source changed or became unreadable during gate validation."
        return 2
    fi
    echo "GATE: PASS (green_streak=$streak)"
}

release_client_gate_argument_contract() {
    [ "$#" -eq 15 ] || return 1
    [ "$2" = --input-seal ] \
        && [ "$4" = --operator-key-file ] \
        && [ "$6" = --expected-operator-key-sha256 ] \
        && [ "$8" = --expected-precommit-session-nonce ] \
        && [ "${10}" = --expected-precommit-run-directory-token ] \
        && [ "${12}" = --expected-precommit-jar-sha256 ] \
        && [ "${14}" = --expected-precommit-world-id ] \
        || return 1
    [ -n "$1" ] && [ -n "$3" ] && [ -n "$5" ] || return 1
    [[ "$7" =~ ^[0-9a-f]{64}$ ]] \
        && [[ "$9" =~ ^[0-9a-f]{64}$ ]] \
        && [[ "${11}" =~ ^[0-9a-f]{64}$ ]] \
        && [[ "${13}" =~ ^[0-9a-f]{64}$ ]] \
        && [[ "${15}" =~ ^[A-Za-z0-9_.-]{1,80}$ ]]
}

