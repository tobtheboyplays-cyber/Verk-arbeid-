+                && last.getInt("Moved") == 0 && last.getInt("Delivered") == 0
+                && last.getInt("Blocker") == RequestBlocker.NONE.wireId()) {
+                normalized = tag.copy();
+                normalized.remove("BlockedFrom");
+            }
+        }
