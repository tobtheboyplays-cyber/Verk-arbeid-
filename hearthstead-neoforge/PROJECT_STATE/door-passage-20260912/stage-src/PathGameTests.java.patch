+    /**
+     * Two normal settlers use one physical, one-cell doorway in opposite
+     * directions. Each route is issued once; a retry here would hide queue
+     * starvation instead of proving passage ownership.
+     */
+    @GameTest(batch = "path", template = "empty16", timeoutTicks = 500)
+    public void oppositeSettlersQueueThroughOneDoorWithoutPushing(GameTestHelper helper) {
+        DoorCorridor corridor = doorCorridor(helper);
+        SettlerEntity northbound = settler(helper, new BlockPos(8, 1, 3));
+        SettlerEntity southbound = settler(helper, new BlockPos(8, 1, 11));
+        BlockPos northTarget = helper.absolutePos(new BlockPos(8, 1, 11));
+        BlockPos southTarget = helper.absolutePos(new BlockPos(8, 1, 3));
+        OneShotMoveGoal northRoute = new OneShotMoveGoal(northbound, northTarget);
+        OneShotMoveGoal southRoute = new OneShotMoveGoal(southbound, southTarget);
+        boolean[] sawOpen = {false};
+        int[] quietTicks = {0};
+        Vec3[] northPrevious = {northbound.position()};
+        Vec3[] southPrevious = {southbound.position()};
+
+        helper.runAtTickTime(5L, () -> {
+            northbound.goalSelector.addGoal(0, northRoute);
+            southbound.goalSelector.addGoal(0, southRoute);
+        });
+        helper.onEachTick(() -> {
+            helper.assertTrue(doorwayBodies(corridor.door(), northbound, southbound) <= 1,
+                "only one physical settler may occupy the door cell"
+                    + " [north=" + northbound.position()
+                    + " south=" + southbound.position() + "]");
+            assertNormalHorizontalStep(helper, northPrevious[0], northbound.position(), "northbound");
+            assertNormalHorizontalStep(helper, southPrevious[0], southbound.position(), "southbound");
+            northPrevious[0] = northbound.position();
+            southPrevious[0] = southbound.position();
+            sawOpen[0] |= doorOpen(helper, corridor.door());
+        });
