+    private static DoorCorridor doorCorridor(GameTestHelper helper) {
+        meadow(helper, 16);
+        for (int edge = 0; edge < 16; edge++) {
+            for (int y = 1; y <= 2; y++) {
+                helper.setBlock(new BlockPos(edge, y, 0), Blocks.STONE_BRICKS);
+                helper.setBlock(new BlockPos(edge, y, 15), Blocks.STONE_BRICKS);
+                helper.setBlock(new BlockPos(0, y, edge), Blocks.STONE_BRICKS);
+                helper.setBlock(new BlockPos(15, y, edge), Blocks.STONE_BRICKS);
+            }
+        }
+        for (int z = 1; z < 15; z++) {
+            for (int y = 1; y <= 2; y++) {
+                helper.setBlock(new BlockPos(7, y, z), Blocks.STONE_BRICKS);
+                helper.setBlock(new BlockPos(9, y, z), Blocks.STONE_BRICKS);
+            }
+        }
+        BlockPos doorRel = new BlockPos(8, 1, 7);
+        var lower = Blocks.OAK_DOOR.defaultBlockState()
+            .setValue(DoorBlock.FACING, Direction.NORTH)
+            .setValue(DoorBlock.HALF, DoubleBlockHalf.LOWER)
+            .setValue(DoorBlock.OPEN, false);
+        helper.setBlock(doorRel, lower);
+        helper.setBlock(doorRel.above(), lower.setValue(DoorBlock.HALF,
+            DoubleBlockHalf.UPPER));
+        return new DoorCorridor(helper.absolutePos(doorRel));
+    }
+
+    private record DoorCorridor(BlockPos door) {}
+
+    private static int doorwayBodies(BlockPos door, SettlerEntity first,
+                                     SettlerEntity second) {
+        AABB doorway = new AABB(door).inflate(.02D);
+        return (first.getBoundingBox().intersects(doorway) ? 1 : 0)
+            + (second.getBoundingBox().intersects(doorway) ? 1 : 0);
+    }
+
+    private static void assertNormalHorizontalStep(GameTestHelper helper,
+                                                    Vec3 previous, Vec3 current,
+                                                    String actor) {
+        double dx = current.x - previous.x;
+        double dz = current.z - previous.z;
+        helper.assertTrue(dx * dx + dz * dz <= .36D,
+            "door queue must not teleport " + actor + " [from=" + previous
+                + " to=" + current + "]");
+    }
