+    @GameTest(batch = "path", template = "empty16", timeoutTicks = 300)
+    public void interruptedDoorHolderExpiresForOppositeSettler(GameTestHelper helper) {
+        DoorCorridor corridor = doorCorridor(helper);
+        SettlerEntity interrupted = settler(helper, new BlockPos(8, 1, 3));
+        SettlerEntity waiter = settler(helper, new BlockPos(8, 1, 11));
+        BlockPos interruptedTarget = helper.absolutePos(new BlockPos(8, 1, 11));
+        BlockPos waiterTarget = helper.absolutePos(new BlockPos(8, 1, 3));
+        OneShotMoveGoal interruptedRoute = new OneShotMoveGoal(interrupted, interruptedTarget);
+        OneShotMoveGoal waiterRoute = new OneShotMoveGoal(waiter, waiterTarget);
+        int[] interruptedAt = {-1};
+        int[] waiterDoorAt = {-1};
+        Vec3[] interruptedPrevious = {interrupted.position()};
+        Vec3[] waiterPrevious = {waiter.position()};
+
+        helper.runAtTickTime(5L, () -> {
+            interrupted.goalSelector.addGoal(0, interruptedRoute);
+            waiter.goalSelector.addGoal(0, waiterRoute);
+        });
+        helper.runAtTickTime(25L, () -> {
+            helper.assertTrue(interrupted.distanceToSqr(corridor.door().getX() + .5D,
+                    interrupted.getY(), corridor.door().getZ() + .5D) <= 9.0D,
+                "the interrupted actor must first have reached reservation range");
+            interrupted.getNavigation().stop();
+            interruptedAt[0] = (int) helper.getTick();
+        });
+        helper.onEachTick(() -> {
+            helper.assertTrue(doorwayBodies(corridor.door(), interrupted, waiter) <= 1,
+                "expiry must not permit two physical bodies in the doorway");
+            assertNormalHorizontalStep(helper, interruptedPrevious[0], interrupted.position(), "interrupted");
+            assertNormalHorizontalStep(helper, waiterPrevious[0], waiter.position(), "waiter");
+            interruptedPrevious[0] = interrupted.position();
+            waiterPrevious[0] = waiter.position();
+            if (waiterDoorAt[0] < 0 && waiter.getBoundingBox().intersects(
+                    new AABB(corridor.door()).inflate(.02D))) {
+                waiterDoorAt[0] = (int) helper.getTick();
+            }
+        });
+        helper.succeedWhen(() -> {
+            boolean waiterReached = waiter.distanceToSqr(waiterTarget.getX() + .5D,
+                waiterTarget.getY(), waiterTarget.getZ() + .5D) <= 2.25D;
+            helper.assertTrue(interruptedRoute.attempted() && waiterRoute.attempted()
+                    && waiterRoute.accepted() && interruptedAt[0] >= 0,
+                "fixture must issue both routes and interrupt only the first");
+            helper.assertTrue(waiterDoorAt[0] >= interruptedAt[0] + 40,
+                "opposite passage must wait for the complete two-second lease"
+                    + " [interruptedAt=" + interruptedAt[0]
+                    + " waiterDoorAt=" + waiterDoorAt[0] + "]");
+            helper.assertTrue(waiterReached
+                    && interrupted.distanceToSqr(interruptedTarget.getX() + .5D,
