      "w": 214
    },
    {
      "t": "label",
      "x": 98,
      "y": 48,
      "text": "Egenskaper vokser bare av \u00e5 gj\u00f8re",
      "box": 214,
      "id": "body_line[0]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 57,
      "text": "arbeidet som trener dem \u2014",
      "box": 214,
      "id": "body_line[1]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 66,
      "text": "t\u00f8mmerhoggerens \u00f8ks bygger Styrke,",
      "box": 214,
      "id": "body_line[2]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 75,
      "text": "budets runder bygger Utholdenhet.",
      "box": 214,
      "id": "body_line[3]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 84,
      "text": "Veksten er langsom og tar aldri helt slutt:",
      "box": 214,
      "id": "body_line[4]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 93,
      "text": "en nybygger du har trent i ukevis, er en",
      "box": 214,
      "id": "body_line[5]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 102,
      "text": "du har bygget selv. Klokskap \u00f8ker",
      "box": 214,
      "id": "body_line[6]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 111,
      "text": "veksten i alle egenskaper, seg selv",
      "box": 214,
      "id": "body_line[7]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 120,
      "text": "inkludert, s\u00e5 det \u00e5 skolere en klok",
      "box": 214,
      "id": "body_line[8]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 129,
      "text": "nybygger tidlig l\u00f8nner seg livet ut. De",
      "box": 214,
      "id": "body_line[9]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 138,
      "text": "fleste nybyggere b\u00e6rer ett s\u00e6rtrekk,",
      "box": 214,
      "id": "body_line[10]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 147,
      "text": "iblant to, og hvert s\u00e6rtrekk koster noe:",
      "box": 214,
      "id": "body_line[11]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 156,
      "text": "den sterkryggede b\u00e6rer mer og g\u00e5r",
      "box": 214,
      "id": "body_line[12]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 165,
      "text": "saktere for det; den l\u00e6renemme l\u00e6rer",
      "box": 214,
      "id": "body_line[13]"
    },
    {
      "t": "label",
      "x": 98,
      "y": 174,
      "text": "raskere, ett skritt bak p\u00e5 alt annet.",
      "box": 214,
      "id": "body_line[14]"
    },
