# Kopier til .env og fyll inn. .env skal ALDRI committes.

# Claude-nøkkelen (ligger allerede på serveren din).
ANTHROPIC_API_KEY=sk-ant-...

# Lang, tilfeldig hemmelighet som signerer innloggings-tokenene.
# Lag én f.eks. med:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bytt-meg-til-en-lang-tilfeldig-streng

# ENKEL INNLOGGING: sett ett felles passord her, så trengs verken
# brukernavn eller users.json. Du logger inn i utvidelsen med bare dette passordet.
ACCESS_PASSWORD=velg-et-passord

# Valgfritt:
# PORT=8787
# MODEL=claude-opus-5            # standardmodell (kan også velges i utvidelsen)
# TOKEN_TTL=12h
# MAX_TEXT_LENGTH=60000

# (Alternativ til ACCESS_PASSWORD: flere brukere med hashet passord)
# USERS=[{"brukernavn":"tobias","passordHash":"$2a$10$..."}]
